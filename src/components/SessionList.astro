---
// Live session list for dispatches: filter by year and/or topic slug.
import { sessions, topicBySlug } from "../lib/data.js";
import SessionCard from "./SessionCard.astro";

const { year, topic, limit } = Astro.props;
const t = topic ? topicBySlug.get(topic) : null;

let list = sessions.filter(
  (s) =>
    (year === undefined || s.year === year) &&
    (!t || s.topicIds.includes(t.id))
);
list.sort((a, b) => (b.duration ?? 0) - (a.duration ?? 0));
if (limit) list = list.slice(0, limit);
---

<div class="card-grid">
  {list.map((s) => (
    <SessionCard session={s} />
  ))}
</div>
