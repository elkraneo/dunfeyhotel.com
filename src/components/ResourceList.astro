---
// Live resource list for dispatches: resources referenced by sessions of a
// given year and/or topic, with descriptions and back-links.
import { sessions, resourceById, topicBySlug } from "../lib/data.js";
import type { Resource, Session } from "../lib/types";
import ResourceIcon from "./ResourceIcon.astro";

type Entry = { resource: Resource; referencedBy: Session[] };

const { year, topic, types } = Astro.props;
const t = topic ? topicBySlug.get(topic) : null;

const scope = sessions.filter(
  (s) =>
    (year === undefined || s.year === year) &&
    (!t || s.topicIds.includes(t.id))
);

const seen = new Map<number, Entry>();
for (const s of scope) {
  for (const rid of s.resourceIds) {
    const r = resourceById.get(rid);
    if (!r) continue;
    if (types && !types.includes(r.type)) continue;
    const entry = seen.get(rid) ?? { resource: r, referencedBy: [] };
    entry.referencedBy.push(s);
    seen.set(rid, entry);
  }
}
const list = [...seen.values()].sort((a, b) =>
  (a.resource.title ?? "").localeCompare(b.resource.title ?? "")
);
---

<ul class="plain">
  {list.map(({ resource: r, referencedBy }) => (
    <li>
      <ResourceIcon type={r.type} />{" "}
      <a href={r.url} rel="external"><strong>{r.title}</strong></a>
      {r.description && <> — {r.description}</>}
      <span class="meta">
        {" · in "}
        {referencedBy.map((s, i) => (
          <>
            {i > 0 && ", "}
            <a href={`/sessions/${s.id}/`}>{s.id.replace("wwdc", "'").replace("-", " §")}</a>
          </>
        ))}
      </span>
    </li>
  ))}
</ul>
