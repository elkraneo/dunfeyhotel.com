---
// One registry row per session: matted thumb, title, dotted leader, duration.
import { formatDuration } from "../lib/data.js";

const { session: s, showYear = true } = Astro.props;
const snips = s.codeSnippets?.length ?? 0;
const metaParts = [
  showYear ? `WWDC${String(s.year).slice(2)}` : null,
  snips ? `${snips} ${snips === 1 ? "snippet" : "snippets"}` : null,
].filter(Boolean);
---

<li class="session-row" data-y={s.year} data-k={(s.topicIds ?? []).join(",")}>
  {s.thumb && (
    <img
      class="row-thumb"
      src={s.thumb}
      alt=""
      loading="lazy"
      width="104"
      height="59"
      onerror="this.remove()"
    />
  )}
  <div class="row-body">
    <h3><a href={`/sessions/${s.id}/`}>{s.title}</a></h3>
    {metaParts.length > 0 && <p class="meta">{metaParts.join(" · ")}</p>}
  </div>
  <span class="row-leader" aria-hidden="true"></span>
  <span class="row-duration">{formatDuration(s.duration)}</span>
</li>
