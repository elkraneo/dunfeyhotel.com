---
// The site-wide cross-section: years + topics + text, persisted across
// pages (URL params first, sessionStorage as fallback). Every section is a
// lens on this one selection. Years render as room-key fobs, topics as
// colored plaques — two different objects from the same hotel.
import { topics, years } from "../lib/data.js";
import { PALETTES } from "../lib/palettes.js";

const { open = false } = Astro.props;
const topicData = topics.map((t) => ({ id: t.id, title: t.title, glyph: t.glyph }));
---

<details class="registry-bar" open={open}>
  <summary>
    <span class="kicker">Front desk</span>
    <span class="meta" id="dh-summary">everything</span>
  </summary>
  <div class="rb-controls">
    <div class="rb-row">
      <label class="visually-hidden" for="dh-q">Search</label>
      <input id="dh-q" class="filter-input" type="search" placeholder="Search…" />
      <span class="meta" id="dh-hint" hidden>⏎ full-text results</span>
      <button type="button" class="linkish" id="dh-clear">clear</button>
    </div>
    <div class="rb-group">
      <span class="rb-label" id="dh-years-label">Years</span>
      <dh-chips class="chip-row" mode="multi" aria-labelledby="dh-years-label" id="dh-years"></dh-chips>
    </div>
    <div class="rb-group">
      <span class="rb-label" id="dh-topics-label">Topics</span>
      <dh-chips class="chip-row" mode="multi" aria-labelledby="dh-topics-label" id="dh-topics"></dh-chips>
    </div>
  </div>
</details>

<script is:inline define:vars={{ topicData, allYears: years, PALETTES }}>
  (() => {
    // Same theme palettes as the observatory charts (src/lib/palettes.js):
    // category colors are one vocabulary across the whole site.
    const colorOf = (i) => {
      const theme = document.documentElement.dataset.theme;
      const p = PALETTES[theme] ?? PALETTES.ledger;
      return p[i % p.length];
    };

    const params = new URLSearchParams(location.search);
    let stored = {};
    try {
      stored = JSON.parse(sessionStorage.getItem("dh-filter") || "{}");
    } catch {}

    const fromParam = (key, valid) =>
      params.has(key)
        ? params.get(key).split(",").map(valid).filter((v) => v !== null)
        : null;

    const slug = (title) =>
      title.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    const topicBySlug = new Map(topicData.map((t) => [slug(t.title), t]));
    const slugOfId = new Map(topicData.map((t) => [t.id, slug(t.title)]));

    window.dhTopicTitles = Object.fromEntries(topicData.map((t) => [t.id, t.title]));
    window.dhFilter = {
      years: new Set(
        fromParam("years", (v) => (allYears.includes(Number(v)) ? Number(v) : null)) ??
          (stored.years ?? []).filter((y) => allYears.includes(y))
      ),
      topics: new Set(
        fromParam("topics", (v) => topicBySlug.get(v)?.id ?? null) ??
          (stored.topics ?? []).filter((id) => topicData.some((t) => t.id === id))
      ),
      q: params.get("q") ?? stored.q ?? "",
    };

    const F = window.dhFilter;
    const onSearchPage = location.pathname.startsWith("/search");
    const summaryEl = document.getElementById("dh-summary");
    const qEl = document.getElementById("dh-q");
    const hintEl = document.getElementById("dh-hint");
    const yearsEl = document.getElementById("dh-years");
    const topicsEl = document.getElementById("dh-topics");

    function sync() {
      // Selecting every item means no filter — collapse to "all".
      if (F.years.size === allYears.length) F.years.clear();
      if (F.topics.size === topicData.length) F.topics.clear();
      const p = new URLSearchParams(location.search);
      F.years.size ? p.set("years", [...F.years].sort().join(",")) : p.delete("years");
      F.topics.size
        ? p.set("topics", [...F.topics].map((id) => slugOfId.get(id)).filter(Boolean).join(","))
        : p.delete("topics");
      F.q ? p.set("q", F.q) : p.delete("q");
      p.delete("year");
      history.replaceState(null, "", p.size ? `?${p}` : location.pathname);
      try {
        sessionStorage.setItem(
          "dh-filter",
          JSON.stringify({ years: [...F.years], topics: [...F.topics], q: F.q })
        );
      } catch {}

      const parts = [];
      if (F.years.size)
        parts.push(
          F.years.size > 4
            ? `${F.years.size} years`
            : [...F.years].sort().map((y) => `’${String(y).slice(2)}`).join("+")
        );
      if (F.topics.size)
        parts.push(
          F.topics.size > 3
            ? `${F.topics.size} topics`
            : [...F.topics]
                .map((id) => topicData.find((t) => t.id === id)?.title)
                .filter(Boolean)
                .join(", ")
        );
      if (F.q) parts.push(`“${F.q}”`);
      summaryEl.textContent = parts.length ? parts.join(" · ") : "everything";
      hintEl.hidden = onSearchPage || !F.q;

      // <dh-chips> renders pressed states (incl. the clear chips) and dims
      // unselected chips while a selection exists.
      yearsEl.values = F.years;
      topicsEl.values = F.topics;

      applyStaticRows();
      dispatchEvent(new CustomEvent("dh-filter"));
    }

    // Static pages (years/topics/related lists) get filtered in place.
    function applyStaticRows() {
      document.querySelectorAll(".session-rows .session-row[data-y]").forEach((row) => {
        const y = Number(row.dataset.y);
        const k = (row.dataset.k || "").split(",").map(Number);
        const title = row.querySelector("h3")?.textContent.toLowerCase() ?? "";
        const hide =
          (F.years.size && !F.years.has(y)) ||
          (F.topics.size && !k.some((id) => F.topics.has(id))) ||
          (F.q && !title.includes(F.q.toLowerCase()));
        row.hidden = Boolean(hide);
      });
    }

    for (const y of [null, ...allYears]) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip fob";
      b.textContent = y === null ? "All years" : `’${String(y).slice(2)}`;
      b.dataset.value = y ?? "";
      yearsEl.append(b);
    }
    yearsEl.addEventListener("change", (e) => {
      F.years = new Set([...e.detail.values].map(Number));
      sync();
    });

    const allTopicsChip = document.createElement("button");
    allTopicsChip.type = "button";
    allTopicsChip.className = "chip";
    allTopicsChip.textContent = "All topics";
    allTopicsChip.dataset.value = "";
    topicsEl.append(allTopicsChip);

    function recolorTopics() {
      topicsEl.querySelectorAll(".chip.topic").forEach((b, i) =>
        b.style.setProperty("--chip-color", colorOf(i))
      );
    }

    topicData.forEach((t, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip topic";
      b.style.setProperty("--chip-color", colorOf(i));
      if (t.glyph) {
        const img = document.createElement("img");
        img.src = t.glyph;
        img.alt = "";
        img.width = 12;
        img.height = 12;
        img.loading = "lazy";
        b.append(img);
      }
      b.append(` ${t.title}`);
      b.dataset.value = t.id;
      topicsEl.append(b);
    });
    topicsEl.addEventListener("change", (e) => {
      F.topics = new Set([...e.detail.values].map(Number));
      sync();
    });
    addEventListener("dh-theme", recolorTopics);

    qEl.value = F.q;
    let timer;
    qEl.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        F.q = qEl.value.trim();
        sync();
      }, 160);
    });
    qEl.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      const q = qEl.value.trim();
      if (!onSearchPage && q) location.href = `/search/?q=${encodeURIComponent(q)}`;
    });
    document.getElementById("dh-clear").addEventListener("click", () => {
      F.years.clear();
      F.topics.clear();
      F.q = "";
      qEl.value = "";
      sync();
    });

    sync();
    addEventListener("DOMContentLoaded", applyStaticRows);
  })();
</script>
