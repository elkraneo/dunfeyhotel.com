---
import Base from "../layouts/Base.astro";
import {
  aggregates,
  sessions,
  resources,
  topics,
  years,
  topicSlug,
} from "../lib/data.js";

const byYear = aggregates.byYear;
const totalTalks = sessions.length;
const totalHours = Math.round(
  Object.values(byYear).reduce((n, y) => n + y.totalDurationSeconds, 0) / 3600
);
const totalDocs = resources.length;
const maxTalks = Math.max(...Object.values(byYear).map((y) => y.talks));

// Topic trend: the last three years against the three before.
const matrix = aggregates.topicYearMatrix;
const recent = years.slice(-3);
const prior = years.slice(-6, -3);
const trends = topics
  .map((t) => {
    const row = matrix[t.title] ?? {};
    const now = recent.reduce((n, y) => n + (row[y] ?? 0), 0);
    const before = prior.reduce((n, y) => n + (row[y] ?? 0), 0);
    return { topic: t, now, before, delta: now - before };
  })
  .sort((a, b) => b.delta - a.delta);

// Resurfaced: facts the data volunteers, recomputed every build. The site
// shows you something you didn't ask for — that's the explorative contract.
const latest = years.at(-1);
const mover = trends[0];
const densest = [...sessions].sort(
  (a, b) => b.codeSnippets.length - a.codeSnippets.length
)[0];
const deepCut = [...sessions]
  .filter((s) => s.year === years[0])
  .sort((a, b) => (b.duration ?? 0) - (a.duration ?? 0))[0];
const resurfaced = [
  {
    fact: `${mover.topic.title} moved hardest: ${mover.before} → ${mover.now} talks across the last three conferences.`,
    href: `/topics/${topicSlug(mover.topic.title)}/`,
    label: "follow the trend",
  },
  {
    fact: `“${densest.title}” (${densest.year}) put ${densest.codeSnippets.length} pieces of code on screen — more than any other session.`,
    href: `/sessions/${densest.id}/`,
    label: "read the code",
  },
  {
    fact: `Only ${aggregates.byYear[years[0]].talks} talks survive from WWDC${String(years[0]).slice(2)}. “${deepCut.title}” is the longest of them.`,
    href: `/sessions/${deepCut.id}/`,
    label: "open the deep cut",
  },
];

const crossSections = [
  {
    label: `Accessibility at WWDC${String(years.at(-1)).slice(2)}`,
    href: `/observatory/?year=${years.at(-1)}&topics=accessibility-and-inclusion`,
  },
  {
    label: "SwiftUI sample code, 2025",
    href: "/observatory/?year=2025&topics=swiftui-and-ui-frameworks&kind=samplecode",
  },
  {
    label: "Spatial computing across all years",
    href: "/observatory/?topics=spatial-computing",
  },
  {
    label: "Machine learning, hours taught",
    href: "/observatory/?topics=ai-and-machine-learning&measure=hours",
  },
];
---

<Base>
  <section class="hero">
    <p class="kicker">Est. 1983, San Mateo · the registry runs {years[0]}–{latest}</p>
    <h1>The conference, kept like a hotel ledger.</h1>
    <p class="lede">
      Every WWDC session since {years[0]} as data: category, duration,
      on-screen code, cross-references. Watching happens at Apple — everything
      else happens here.
    </p>
    <form class="concierge" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="q">Search the registry</label>
      <input
        id="q"
        name="q"
        type="search"
        placeholder={`Search ${totalTalks.toLocaleString("en")} sessions, their code and documents…`}
      />
      <button class="watch" type="submit">Search</button>
    </form>
    <div class="figures">
      <div class="figure"><b>{totalTalks.toLocaleString("en")}</b><span>talks</span></div>
      <div class="figure"><b>{totalHours.toLocaleString("en")}</b><span>hours</span></div>
      <div class="figure"><b>{years.length}</b><span>conferences</span></div>
      <div class="figure"><b>{totalDocs.toLocaleString("en")}</b><span>documents referenced</span></div>
    </div>
  </section>

  <section aria-labelledby="resurfaced">
    <h2 class="kicker" id="resurfaced">Resurfaced from the registry</h2>
    <ul class="plain">
      {resurfaced.map((r) => (
        <li>
          {r.fact}{" "}
          <a class="timestamp-link" href={r.href}>{r.label}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="cross-sections">
    <h2 class="kicker" id="cross-sections">Start from a cross-section</h2>
    <p class="chip-row">
      {crossSections.map((c) => (
        <a class="chip linkchip" href={c.href}>{c.label}</a>
      ))}
    </p>
  </section>

  <section class="block" aria-labelledby="registry">
    <h2 class="kicker" id="registry">Check-ins by year</h2>
    <table class="ledger">
      <caption class="visually-hidden">Talks, hours and transcripts per WWDC year</caption>
      <thead>
        <tr>
          <th scope="col">Year</th>
          <th scope="col" class="num">Talks</th>
          <th scope="col" class="num">Hours</th>
          <th scope="col" class="num">Transcripts</th>
          <th scope="col" aria-label="Relative volume"></th>
          <th scope="col">Catalog</th>
        </tr>
      </thead>
      <tbody>
        {[...years].reverse().map((y) => {
          const row = byYear[y];
          return (
            <tr>
              <td><a href={`/years/${y}/`}>WWDC{String(y).slice(2)}</a></td>
              <td class="num">{row.talks}</td>
              <td class="num">{Math.round(row.totalDurationSeconds / 3600)}</td>
              <td class="num">{row.withTranscript || "—"}</td>
              <td style="width:30%">
                <span
                  class="bar"
                  style={`inline-size:${(row.talks / maxTalks) * 100}%`}
                  aria-hidden="true"
                />
              </td>
              <td><a class="timestamp-link" href={`/years/${y}/documents/`}>documents<span class="visually-hidden"> referenced at WWDC{String(y).slice(2)}</span></a></td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="footnote">
      Talks only — no labs or get-togethers. Pre-2019 years reflect what Apple
      still publishes, not the full conference.
    </p>
  </section>

  <section class="block" aria-labelledby="trends">
    <h2 class="kicker" id="trends">
      Topic movement · {prior[0]}–{prior.at(-1)} vs {recent[0]}–{recent.at(-1)}
    </h2>
    <table class="ledger">
      <caption class="visually-hidden">Talks per topic, recent three years versus the prior three</caption>
      <thead>
        <tr>
          <th scope="col">Topic</th>
          <th scope="col" class="num">{prior[0]}–{String(prior.at(-1)).slice(2)}</th>
          <th scope="col" class="num">{recent[0]}–{String(recent.at(-1)).slice(2)}</th>
          <th scope="col" class="num">Δ</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        {trends.map(({ topic, now, before, delta }) => (
          <tr>
            <td>
              {topic.glyph && (
                <img class="topic-glyph" src={topic.glyph} alt="" width="14" height="14" loading="lazy" />
              )}{" "}
              <a href={`/topics/${topicSlug(topic.title)}/`}>{topic.title}</a>
            </td>
            <td class="num">{before}</td>
            <td class="num">{now}</td>
            <td class="num" style={delta > 0 ? "color:var(--oxblood);font-weight:600" : undefined}>
              {delta > 0 ? `+${delta}` : delta}
            </td>
            <td>
              <a class="timestamp-link" href={`/observatory/?topics=${topicSlug(topic.title)}`}>observe<span class="visually-hidden"> {topic.title} in the observatory</span></a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="footnote">
      Three-year windows because topics skip years — single-year deltas are
      mostly noise. Any other range:
      <a href="/observatory/">the observatory</a>.
    </p>
  </section>
</Base>
