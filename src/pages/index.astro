---
import Base from "../layouts/Base.astro";
import {
  aggregates,
  sessions,
  resources,
  topics,
  years,
  topicSlug,
} from "../lib/data.js";
import lostAndFound from "../../data/normalized/lost-and-found.json";

const byYear = aggregates.byYear;
const totalTalks = sessions.length;
const totalHours = Math.round(
  Object.values(byYear).reduce((n, y) => n + y.totalDurationSeconds, 0) / 3600
);
const totalDocs = resources.length;
const latest = years.at(-1);
const earliest = years[0];
const yy = (y: number) => String(y).slice(2);
const fmtN = (n: number) => n.toLocaleString("en");

// Topic trend: the last three years against the three before.
const matrix = aggregates.topicYearMatrix;
const recent = years.slice(-3);
const prior = years.slice(-6, -3);
const trends = topics
  .map((t) => {
    const row = matrix[t.title] ?? {};
    const now = recent.reduce((n, y) => n + (row[y] ?? 0), 0);
    const before = prior.reduce((n, y) => n + (row[y] ?? 0), 0);
    return { topic: t, now, before, delta: now - before };
  })
  .sort((a, b) => b.delta - a.delta);

// Resurfaced — the page's centerpiece: findings the data volunteers,
// recomputed on every snapshot. The site hands you something before you ask
// for it; that's the explorative contract. Each candidate is computed, then a
// varied, de-duplicated set is rendered (one topic-up, one topic-down, two
// session angles, one edition, one from the archive).
const mover = trends[0];
const faller = trends.at(-1);
const densest = [...sessions].sort(
  (a, b) => b.codeSnippets.length - a.codeSnippets.length
)[0];
const deepCut = [...sessions]
  .filter((s) => s.year === earliest)
  .sort((a, b) => (b.duration ?? 0) - (a.duration ?? 0))[0];
const codeYear = [...years].sort(
  (a, b) => byYear[b].codeSnippets - byYear[a].codeSnippets
)[0];
const lf = lostAndFound.counts;

const showFaller = !!faller && faller !== mover && faller.delta < 0;
const resurfaced = [
  {
    fact: `${mover.topic.title} moved hardest — ${mover.before} → ${mover.now} sessions across the last three editions.`,
    href: `/topics/${topicSlug(mover.topic.title)}/`,
    label: "the trend",
  },
  ...(showFaller
    ? [
        {
          fact: `${faller!.topic.title} cooled the most over the same span — ${faller!.before} → ${faller!.now} sessions.`,
          href: `/topics/${topicSlug(faller!.topic.title)}/`,
          label: "where it went",
        },
      ]
    : []),
  {
    fact: `“${densest.title}” (${densest.year}) put ${densest.codeSnippets.length} pieces of code on screen — more than any other session.`,
    href: `/sessions/${densest.id}/`,
    label: "read the code",
  },
  {
    fact: `WWDC${yy(codeYear)} alone put ${fmtN(byYear[codeYear].codeSnippets)} code snippets on screen — the most of any edition.`,
    href: `/years/${codeYear}/`,
    label: "open the edition",
  },
  {
    fact: `Only ${byYear[earliest].talks} sessions survive from WWDC${yy(earliest)} — “${deepCut.title}” is the longest still standing.`,
    href: `/sessions/${deepCut.id}/`,
    label: "the deep cut",
  },
  {
    fact: `Apple has quietly delisted ${fmtN(lf.total)} sessions and documents since ${earliest} — ${fmtN(lf.recoverable)} are still reachable on its own servers.`,
    href: "/lost-and-found/",
    label: "the lost & found",
  },
];

const crossSections = [
  {
    label: `Accessibility at WWDC${yy(latest!)}`,
    href: `/observatory/?year=${latest}&topics=accessibility-and-inclusion`,
  },
  {
    label: "SwiftUI sample code, 2025",
    href: "/observatory/?year=2025&topics=swiftui-and-ui-frameworks&kind=samplecode",
  },
  {
    label: "Spatial computing across all years",
    href: "/observatory/?topics=spatial-computing",
  },
  {
    label: "Machine learning, hours taught",
    href: "/observatory/?topics=ai-and-machine-learning&measure=hours",
  },
];
---

<Base>
  <section class="hero">
    <p class="kicker">Est. 1983, San Mateo · the registry runs {earliest}–{latest}</p>
    <h1>WWDC <span class="cast">as!</span> Data</h1>
    <p class="lede">
      Every WWDC session since {earliest} as data: category, duration,
      on-screen code, cross-references. Watching happens at Apple — everything
      else happens here.
    </p>
    <p>
      <a class="watch" href="/observatory/">Enter the observatory</a>
    </p>
    <div class="figures">
      <div class="figure"><b>{totalTalks.toLocaleString("en")}</b><span>sessions</span></div>
      <div class="figure"><b>{totalHours.toLocaleString("en")}</b><span>hours</span></div>
      <div class="figure"><b>{years.length}</b><span>editions</span></div>
      <div class="figure"><b>{totalDocs.toLocaleString("en")}</b><span>documents referenced</span></div>
    </div>
  </section>

  <section class="resurfaced" aria-labelledby="resurfaced">
    <h2 class="kicker" id="resurfaced">Resurfaced from the registry</h2>
    <p class="meta resurfaced-sub">
      Findings the data volunteers — recomputed on every snapshot, so the desk
      reads differently each time it’s restocked.
    </p>
    <ul class="plain">
      {resurfaced.map((r) => (
        <li>
          <span class="fact">{r.fact}</span>{" "}
          <a class="timestamp-link" href={r.href}>{r.label} →</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="trends">
    <h2 class="kicker" id="trends">
      Topic movement · {prior[0]}–{yy(prior.at(-1)!)} vs {recent[0]}–{yy(recent.at(-1)!)}
    </h2>
    <table class="ledger">
      <caption class="visually-hidden">Sessions per topic, recent three years versus the prior three</caption>
      <thead>
        <tr>
          <th scope="col">Topic</th>
          <th scope="col" class="num">{prior[0]}–{yy(prior.at(-1)!)}</th>
          <th scope="col" class="num">{recent[0]}–{yy(recent.at(-1)!)}</th>
          <th scope="col" class="num">Δ</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        {trends.map(({ topic, now, before, delta }) => (
          <tr>
            <td>
              {topic.glyph && (
                <img class="topic-glyph" src={topic.glyph} alt="" width="14" height="14" loading="lazy" />
              )}{" "}
              <a href={`/topics/${topicSlug(topic.title)}/`}>{topic.title}</a>
            </td>
            <td class="num">{before}</td>
            <td class="num">{now}</td>
            <td class="num" style={delta > 0 ? "color:var(--oxblood);font-weight:600" : undefined}>
              {delta > 0 ? `+${delta}` : delta}
            </td>
            <td>
              <a class="timestamp-link" href={`/observatory/?topics=${topicSlug(topic.title)}`}>observe<span class="visually-hidden"> {topic.title} in the observatory</span></a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="footnote">
      Three-year windows because topics skip years — single-year deltas are
      mostly noise. Any other range:
      <a href="/observatory/">the observatory</a>.
    </p>
  </section>

  <section class="block" aria-labelledby="cross-sections">
    <h2 class="kicker" id="cross-sections">Start from the front desk</h2>
    <p class="chip-row">
      {crossSections.map((c) => (
        <a class="chip linkchip" href={c.href}>{c.label}</a>
      ))}
    </p>
  </section>

  <section class="block" aria-labelledby="editions">
    <h2 class="kicker" id="editions">The editions</h2>
    <p class="chip-row">
      {[...years].reverse().map((y) => (
        <a class="chip linkchip" href={`/years/${y}/`}>WWDC{yy(y)}</a>
      ))}
    </p>
    <p class="footnote">
      Videos and talks only — no labs or get-togethers. Pre-2019 editions
      reflect what Apple still publishes, not the full conference. Counts and
      durations per edition live in <a href="/observatory/">the observatory</a>.
    </p>
  </section>
</Base>

<style>
  /* Resurfaced is the centerpiece: a double rule, a framing subhead, and the
     facts set in the display face so they read as findings, not list items. */
  .resurfaced {
    border-top: 3px double var(--rule-strong);
    padding-top: 1.1rem;
    margin-block-start: 2.6rem;
  }

  .resurfaced-sub {
    max-width: var(--measure);
    margin-block: 0.2rem 0.6rem;
  }

  .resurfaced .plain li {
    padding-block: 0.95rem;
    border-bottom: 1px dotted var(--rule-strong);
    max-width: var(--measure);
  }

  .resurfaced .fact {
    font-family: var(--font-display);
    font-size: 1.18rem;
    line-height: 1.45;
  }

  .resurfaced .timestamp-link {
    white-space: nowrap;
  }
</style>
