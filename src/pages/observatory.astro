---
import Base from "../layouts/Base.astro";
import { years } from "../lib/data.js";

const spanYears = years.length;
---

<Base
  title="Observatory"
  description={`Coordinated, explorable views of ${spanYears} years of WWDC — and every cross-section materializes as an actionable list of sessions and resources.`}
  wide
  searchable={false}
>
  <section class="hero">
    <p class="kicker">The observatory · the view from the roof</p>
    <h1>{spanYears} years, any angle.</h1>
    <p class="lede">
      Set the controls — year, topics, measure — and the charts update
      together; the cross-section below lists every matching session. Each
      view has its own URL.
    </p>
  </section>

  <div class="controls" role="group" aria-label="Observatory controls">
    <div class="lens">
      <p class="kicker" id="measure-label">Measure</p>
      <dh-chips class="chip-row" mode="single" value="sessions" aria-labelledby="measure-label" id="measure-chips">
        <button type="button" class="chip" data-value="sessions">Sessions</button>
        <button type="button" class="chip" data-value="hours">Hours</button>
        <button type="button" class="chip" data-value="snippets">Code snippets</button>
      </dh-chips>
    </div>
  </div>

  <div class="observatory-grid" data-dh-reactive>
    <figure class="panel" id="panel-years">
      <figcaption class="kicker" id="caption-years"></figcaption>
      <dh-chips class="view-toggle" mode="single" value="chart" aria-label="Show as">
        <button type="button" class="chip" data-value="chart">Chart</button>
        <button type="button" class="chip" data-value="table">Table</button>
      </dh-chips>
      <div class="plot" id="plot-years"></div>
      <div class="chart-table" id="data-years" hidden></div>
    </figure>
    <figure class="panel" id="panel-distribution">
      <figcaption class="kicker" id="caption-distribution"></figcaption>
      <dh-chips class="view-toggle" mode="single" value="chart" aria-label="Show as">
        <button type="button" class="chip" data-value="chart">Chart</button>
        <button type="button" class="chip" data-value="table">Table</button>
      </dh-chips>
      <div class="plot" id="plot-distribution"></div>
      <div class="chart-table" id="data-distribution" hidden></div>
    </figure>
    <figure class="panel" id="panel-share">
      <figcaption class="kicker" id="caption-share"></figcaption>
      <dh-chips class="view-toggle" mode="single" value="chart" aria-label="Show as">
        <button type="button" class="chip" data-value="chart">Donut</button>
        <button type="button" class="chip" data-value="table">Table</button>
      </dh-chips>
      <div class="plot" id="plot-share"></div>
      <div class="chart-table" id="data-share" hidden></div>
    </figure>
    <figure class="panel wide" id="panel-lines">
      <figcaption class="kicker" id="caption-lines"></figcaption>
      <dh-chips class="view-toggle" mode="single" value="chart" aria-label="Show as">
        <button type="button" class="chip" data-value="chart">Chart</button>
        <button type="button" class="chip" data-value="table">Table</button>
      </dh-chips>
      <div class="plot" id="plot-lines"></div>
      <div class="chart-table" id="data-lines" hidden></div>
    </figure>
  </div>

  <section class="block" aria-labelledby="cross-section" id="cross-section-block">
    <h2 class="kicker" id="cross-section">Cross-section</h2>
    <div class="cross-controls">
      <dh-chips class="chip-row" mode="single" aria-label="Collect as" id="kind-chips"></dh-chips>
      <dh-chips class="seg" mode="single" value="list" aria-label="Display" id="view-chips">
        <button type="button" class="seg-opt" data-value="list">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <line x1="2.5" y1="4" x2="13.5" y2="4" /><line x1="2.5" y1="8" x2="13.5" y2="8" /><line x1="2.5" y1="12" x2="13.5" y2="12" />
          </svg>
          <span>List</span>
        </button>
        <button type="button" class="seg-opt" data-value="grid">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="2.3" y="2.3" width="4.6" height="4.6" rx="1" /><rect x="9.1" y="2.3" width="4.6" height="4.6" rx="1" /><rect x="2.3" y="9.1" width="4.6" height="4.6" rx="1" /><rect x="9.1" y="9.1" width="4.6" height="4.6" rx="1" />
          </svg>
          <span>Grid</span>
        </button>
      </dh-chips>
      <label class="meta" for="cross-sort">
        Sort
        <select id="cross-sort" class="theme-select"></select>
      </label>
    </div>
    <p class="meta" id="cross-summary" role="status"></p>
    <div id="cross-results"></div>
    <p><button type="button" class="watch secondary" id="cross-more" hidden>Show everything</button></p>
  </section>

  <p class="footnote">
    Charts count by primary topic; the cross-section matches any active topic.
    Pre-2019 years reflect what Apple still publishes. Charts:
    <a href="https://observablehq.com/plot/">Observable Plot</a>.
  </p>

  <script>
    import * as Plot from "@observablehq/plot";
    import explorer from "../../data/normalized/explorer.json";
    import index from "../../data/normalized/observatory-index.json";
    import { PALETTES } from "../lib/palettes.js";

    const { years, topics, sessionCells } = explorer;
    const { sessions, resources } = index;
    const resourceById = new Map(resources.map((r) => [r.id, r]));

    const topicIndex = new Map(topics.map((t, i) => [t.id, i]));
    const palette = () => {
      const theme = document.documentElement.dataset.theme;
      return PALETTES[theme] ?? PALETTES.ledger;
    };
    const colorOf = (topicId) => {
      const p = palette();
      return p[topicIndex.get(topicId) % p.length];
    };
    const topicColor = { get: colorOf };
    const topicTitle = new Map(topics.map((t) => [t.id, t.title]));
    const topicGlyph = new Map(topics.map((t) => [t.id, t.glyph]));
    const slugOf = (title) =>
      title.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    const topicBySlug = new Map(topics.map((t) => [slugOf(t.title), t]));

    const MEASURES = {
      sessions: { label: "sessions", of: (c) => c.sessions, int: true },
      hours: { label: "hours", of: (c) => c.seconds / 3600, int: false },
      snippets: { label: "code snippets", of: (c) => c.snippets, int: true },
    };

    // Counts can't be fractional: keep the value axis on whole numbers.
    // Small ranges get a tick per integer; larger ones keep Plot's nice
    // steps but never a decimal label.
    const valScale = (measure, maxVal) =>
      !measure.int
        ? {}
        : { tickFormat: "d", ...(maxVal <= 8 ? { interval: 1 } : {}) };
    const KINDS = [
      { key: "sessions", label: "Sessions" },
      { key: "samplecode", label: "Sample code" },
      { key: "documentation", label: "Documentation" },
      { key: "guide", label: "Guides" },
      { key: "download", label: "Downloads" },
    ];
    const SESSION_SORTS = {
      newest: { label: "Newest", fn: (a, b) => b.y - a.y || b.d - a.d },
      oldest: { label: "Oldest", fn: (a, b) => a.y - b.y || b.d - a.d },
      longest: { label: "Longest", fn: (a, b) => b.d - a.d },
      code: { label: "Most code", fn: (a, b) => b.c - a.c },
      title: { label: "Title A–Z", fn: (a, b) => a.t.localeCompare(b.t) },
    };
    const RESOURCE_SORTS = {
      title: { label: "Title A–Z", fn: (a, b) => a.r.t.localeCompare(b.r.t) },
      cited: { label: "Most cited", fn: (a, b) => b.by.length - a.by.length },
    };

    // ——— state: years/topics/q live in the site-wide cross-section bar
    // (window.dhFilter); this page owns only measure, kind and sort. ———
    const params = new URLSearchParams(location.search);
    const state = {
      measure: MEASURES[params.get("measure")] ? params.get("measure") : "sessions",
      kind: KINDS.some((k) => k.key === params.get("kind")) ? params.get("kind") : "sessions",
      sort: params.get("sort"),
      view: params.get("view") === "grid" ? "grid" : "list",
      expanded: false,
    };
    const F = () => window.dhFilter ?? { years: new Set(), topics: new Set(), q: "" };
    const activeSet = () => {
      const f = F();
      return f.topics.size ? f.topics : new Set(topics.map((t) => t.id));
    };

    function syncURL() {
      const p = new URLSearchParams(location.search);
      state.measure !== "sessions" ? p.set("measure", state.measure) : p.delete("measure");
      state.kind !== "sessions" ? p.set("kind", state.kind) : p.delete("kind");
      state.sort ? p.set("sort", state.sort) : p.delete("sort");
      state.view === "grid" ? p.set("view", "grid") : p.delete("view");
      history.replaceState(null, "", p.size ? `?${p}` : location.pathname);
    }

    const barRx = () =>
      (document.documentElement.dataset.theme ?? "").startsWith("cupertino") ? 4 : 0;
    const css = (name) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const fmt = (n) => Math.round(n).toLocaleString("en");
    const yearLabel = (y) => `WWDC${String(y).slice(2)}`;
    const shortYear = (y) => `’${String(y).slice(2)}`;
    const minutes = (d) => (d ? `${Math.round(d / 60)} min` : "—");
    const yearIn = (y) => {
      const f = F();
      return f.years.size === 0 || f.years.has(y);
    };
    const yearScope = () => {
      const f = F();
      return f.years.size ? [...f.years].sort().map(shortYear).join("+") : null;
    };

    // ——— controls: every group is a <dh-chips>; pages own the state and
    // re-render on the element's change event. ———
    const measureChips = document.getElementById("measure-chips");
    measureChips.value = state.measure;
    measureChips.addEventListener("change", (e) => {
      state.measure = e.detail.value;
      render();
    });

    const kindChips = document.getElementById("kind-chips");
    for (const k of KINDS) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip";
      b.textContent = k.label;
      b.dataset.value = k.key;
      kindChips.append(b);
    }
    kindChips.addEventListener("change", (e) => {
      state.kind = e.detail.value;
      state.sort = null;
      state.expanded = false;
      render();
    });

    const viewChips = document.getElementById("view-chips");
    viewChips.addEventListener("change", (e) => {
      state.view = e.detail.value;
      render();
    });

    const sortSelect = document.getElementById("cross-sort");
    sortSelect.addEventListener("change", () => {
      state.sort = sortSelect.value;
      state.expanded = false;
      render();
    });
    function syncSortOptions() {
      const sorts = state.kind === "sessions" ? SESSION_SORTS : RESOURCE_SORTS;
      const fallback = state.kind === "sessions" ? "newest" : "title";
      if (!sorts[state.sort]) state.sort = fallback;
      sortSelect.replaceChildren(
        ...Object.entries(sorts).map(([key, s]) => {
          const o = document.createElement("option");
          o.value = key;
          o.textContent = s.label;
          o.selected = key === state.sort;
          return o;
        })
      );
      return sorts[state.sort].fn;
    }

    const moreButton = document.getElementById("cross-more");
    moreButton.addEventListener("click", () => {
      state.expanded = true;
      render();
    });

    // Chart ⇄ table per panel — both views are first-class.
    document.querySelectorAll(".panel .view-toggle").forEach((group) => {
      const panel = group.closest(".panel");
      group.addEventListener("change", (e) => {
        panel.querySelector(".plot").hidden = e.detail.value !== "chart";
        panel.querySelector(".chart-table").hidden = e.detail.value !== "table";
      });
    });

    // ——— rendering ———
    // Charts are presentational (aria-hidden); the same data is always
    // available as a real table right under each panel.
    const mount = (id, node) => {
      node.setAttribute("aria-hidden", "true");
      document.getElementById(id).replaceChildren(node);
    };

    // Topic distribution as a donut: every topic is a slice sized by its
    // share of the scope; icons ride the wide slices, the hovered slice
    // names itself in the hole, and a click toggles that topic upstream.
    const SVGNS = "http://www.w3.org/2000/svg";
    const donutChart = (data, { width, total, measureLabel, scopeLabel }) => {
      const size = Math.max(220, Math.min(width, 360));
      const cx = size / 2;
      const cy = size / 2;
      const outerR = size / 2 - 6;
      const innerR = outerR * 0.58;
      const iconR = (outerR + innerR) / 2;
      const TAU = Math.PI * 2;
      const polar = (r, a) => [cx + r * Math.cos(a), cy + r * Math.sin(a)];
      const arcPath = (r0, r1, s, e) => {
        const [x0, y0] = polar(r1, s);
        const [x1, y1] = polar(r1, e);
        const [x2, y2] = polar(r0, e);
        const [x3, y3] = polar(r0, s);
        const large = e - s > Math.PI ? 1 : 0;
        return `M${x0} ${y0}A${r1} ${r1} 0 ${large} 1 ${x1} ${y1}L${x2} ${y2}A${r0} ${r0} 0 ${large} 0 ${x3} ${y3}Z`;
      };

      const wrap = document.createElement("div");
      wrap.className = "donut-wrap";

      const center = document.createElement("div");
      center.className = "donut-center";
      const centerTitle = document.createElement("strong");
      const centerValue = document.createElement("span");
      center.append(centerTitle, centerValue);
      const resetCenter = () => {
        centerTitle.textContent = scopeLabel;
        centerValue.textContent = `${fmt(total)} ${measureLabel}`;
      };
      resetCenter();

      const svg = document.createElementNS(SVGNS, "svg");
      svg.setAttribute("viewBox", `0 0 ${size} ${size}`);
      svg.setAttribute("width", size);
      svg.setAttribute("height", size);
      svg.setAttribute("aria-hidden", "true");
      svg.classList.add("donut");

      const sel = F().topics;
      const hasSel = sel.size > 0;
      let a0 = -Math.PI / 2;

      for (const d of data) {
        if (!total) break;
        const frac = d.value / total;
        const a1 = a0 + frac * TAU;
        const mid = (a0 + a1) / 2;
        const active = !hasSel || sel.has(d.id);
        const pct = Math.round(frac * 100);

        const g = document.createElementNS(SVGNS, "g");
        g.classList.add("donut-slice");
        if (!active) g.classList.add("dim");

        const path = document.createElementNS(SVGNS, "path");
        path.setAttribute("d", arcPath(innerR, outerR, a0, a1));
        // Selected topics keep their colour; the rest grey out, same as the
        // out-of-scope bars elsewhere.
        path.setAttribute("fill", active ? colorOf(d.id) : "var(--bar-muted)");
        g.append(path);

        // Icon only where the slice is wide enough to seat the badge.
        if (frac * TAU * iconR > 22) {
          const [ix, iy] = polar(iconR, mid);
          const badge = document.createElementNS(SVGNS, "circle");
          badge.setAttribute("cx", ix);
          badge.setAttribute("cy", iy);
          badge.setAttribute("r", 11);
          badge.classList.add("donut-badge");
          g.append(badge);
          const glyph = topicGlyph.get(d.id);
          if (glyph) {
            const img = document.createElementNS(SVGNS, "image");
            img.setAttribute("href", glyph);
            img.setAttribute("x", ix - 7);
            img.setAttribute("y", iy - 7);
            img.setAttribute("width", 14);
            img.setAttribute("height", 14);
            img.classList.add("donut-glyph");
            g.append(img);
          }
        }

        g.addEventListener("mouseenter", () => {
          centerTitle.textContent = d.topic;
          centerValue.textContent = `${fmt(d.value)} ${measureLabel} · ${pct}%`;
        });
        g.addEventListener("mouseleave", resetCenter);
        g.addEventListener("click", () => {
          document.querySelector(`#dh-topics button[data-value="${d.id}"]`)?.click();
        });
        svg.append(g);
        a0 = a1;
      }

      wrap.append(svg, center);
      return wrap;
    };
    const esc = (v) =>
      String(v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const dataTable = (id, headers, rows) => {
      document.getElementById(id).innerHTML = `<table class="ledger">
        <thead><tr>${headers.map((h) => `<th scope="col">${esc(h)}</th>`).join("")}</tr></thead>
        <tbody>${rows
          .map(
            (r) =>
              `<tr>${r
                .map((c, i) =>
                  i === 0 ? `<th scope="row">${esc(c)}</th>` : `<td class="num">${esc(c)}</td>`
                )
                .join("")}</tr>`
          )
          .join("")}</tbody>
      </table>`;
    };
    const PREVIEW = 24;

    function matchingSessions() {
      const active = activeSet();
      const q = F().q.toLowerCase();
      return sessions.filter(
        (s) =>
          yearIn(s.y) &&
          s.k.some((id) => active.has(id)) &&
          (!q || s.t.toLowerCase().includes(q))
      );
    }

    function renderCrossSection() {
      const matched = matchingSessions();
      const summary = document.getElementById("cross-summary");
      const results = document.getElementById("cross-results");

      kindChips.value = state.kind;
      viewChips.hidden = state.kind !== "sessions";
      viewChips.value = state.view;

      const sortFn = syncSortOptions();
      if (state.kind === "sessions") {
        const list = [...matched].sort(sortFn);
        const visible = state.expanded ? list : list.slice(0, PREVIEW);
        summary.textContent = `${list.length} sessions matching any active topic${yearScope() ? ` · ${yearScope()}` : ""}`;
        const grid = state.view === "grid";
        const rows = document.createElement(grid ? "div" : "ul");
        rows.className = grid ? "gcards" : "session-rows";
        visible.forEach((s, i) => {
          const snips = s.c ? ` · ${s.c} ${s.c === 1 ? "snippet" : "snippets"}` : "";
          const row = document.createElement(grid ? "div" : "li");
          row.className = (grid ? "gcard" : "session-row") + " appear";
          row.style.animationDelay = `${Math.min(i * 22, 440)}ms`;
          if (grid) {
            row.innerHTML = `
              ${s.img ? `<a class="gcard-thumb-link" href="/sessions/${s.id}/" tabindex="-1" aria-hidden="true"><img class="gcard-thumb" src="${s.img}" alt="" loading="lazy" width="250" height="141" onerror="this.closest('.gcard-thumb-link').remove()"></a>` : ""}
              <h3><a href="/sessions/${s.id}/"></a></h3>
              <p class="meta">${yearLabel(s.y)} · ${minutes(s.d)}${snips}</p>`;
          } else {
            row.innerHTML = `
              ${s.img ? `<img class="row-thumb" src="${s.img}" alt="" loading="lazy" width="104" height="59" onerror="this.remove()">` : ""}
              <div class="row-body">
                <h3><a href="/sessions/${s.id}/"></a></h3>
                <p class="meta">${yearLabel(s.y)}${snips}</p>
              </div>
              <span class="row-leader" aria-hidden="true"></span>
              <span class="row-duration">${minutes(s.d)}</span>`;
          }
          row.querySelector("a").textContent = s.t;
          rows.append(row);
        });
        mount("cross-results", rows);
        moreButton.hidden = state.expanded || list.length <= PREVIEW;
        moreButton.textContent = `Show all ${list.length}`;
      } else {
        const seen = new Map();
        for (const s of matched) {
          for (const rid of s.r) {
            const r = resourceById.get(rid);
            if (!r || r.type !== state.kind) continue;
            const entry = seen.get(rid) ?? { r, by: [] };
            entry.by.push(s);
            seen.set(rid, entry);
          }
        }
        const list = [...seen.values()].sort(sortFn);
        const visible = state.expanded ? list : list.slice(0, PREVIEW * 2);
        summary.textContent = `${list.length} ${KINDS.find((k) => k.key === state.kind).label.toLowerCase()}${yearScope() ? ` · ${yearScope()}` : ""}`;
        const ul = document.createElement("ul");
        ul.className = "plain";
        for (const { r, by } of visible) {
          const li = document.createElement("li");
          const link = document.createElement("a");
          link.href = r.u;
          link.rel = "external";
          link.innerHTML = `<strong></strong>`;
          link.querySelector("strong").textContent = r.t;
          li.append(link);
          const meta = document.createElement("span");
          meta.className = "meta";
          meta.append(" · in ");
          by.slice(0, 4).forEach((s, i) => {
            if (i) meta.append(", ");
            const a = document.createElement("a");
            a.href = `/sessions/${s.id}/`;
            a.title = s.t;
            a.textContent = `${shortYear(s.y)} §${s.id.split("-")[1]}`;
            meta.append(a);
          });
          if (by.length > 4) meta.append(` +${by.length - 4}`);
          li.append(meta);
          ul.append(li);
        }
        mount("cross-results", ul);
        moreButton.hidden = state.expanded || list.length <= PREVIEW * 2;
        moreButton.textContent = `Show all ${list.length}`;
      }
    }

    function render() {
      syncURL();
      const m = MEASURES[state.measure];
      const active = activeSet();
      const cells = sessionCells.filter((c) => active.has(c.topicId));
      const widthOf = (id) => Math.max(280, document.getElementById(id).clientWidth - 8);
      const width = widthOf("panel-years");
      const tipYear = { format: { x: (y) => yearLabel(y) } };


      // A · measure per year
      const perYear = years.map((year) => ({
        year,
        value: cells.filter((c) => c.year === year).reduce((n, c) => n + m.of(c), 0),
      }));
      const total = perYear
        .filter((d) => yearIn(d.year))
        .reduce((n, d) => n + d.value, 0);
      document.getElementById("caption-years").textContent =
        `${m.label} by year, primary topic · ${fmt(total)} ${yearScope() ?? "total"}`;
      mount(
        "plot-years",
        Plot.plot({
          width,
          height: 220,
          marginLeft: 46,
          style: { fontSize: "12.5px" },
          x: { tickFormat: shortYear, label: null, type: "band" },
          y: {
            label: m.label,
            grid: true,
            nice: true,
            ...valScale(m, Math.max(0, ...perYear.map((d) => d.value))),
          },
          marks: [
            Plot.barY(perYear, {
              x: "year",
              y: "value",
              rx: barRx(),
              fill: (d) => (yearIn(d.year) ? css("--oxblood") : css("--bar-muted")),
              tip: tipYear,
            }),
          ],
        })
      );
      dataTable(
        "data-years",
        ["Year", m.label],
        perYear.map((d) => [yearLabel(d.year), fmt(d.value)])
      );

      // B · distribution across topics — donut (share of whole), bars (rank),
      // or table. Scope by year only (not the topic selection) so the donut
      // is a true whole-ring share; bars then narrow to the active topics.
      // Bars use the active selection; the donut (below) shows every topic.
      const activeScope = cells.filter((c) => yearIn(c.year));
      const perTopic = topics
        .filter((t) => active.has(t.id))
        .map((t) => ({
          topic: t.title,
          id: t.id,
          value: activeScope.filter((c) => c.topicId === t.id).reduce((n, c) => n + m.of(c), 0),
        }))
        .filter((d) => d.value > 0)
        .sort((a, b) => b.value - a.value);
      const distScope = yearScope() ?? "all years";
      document.getElementById("caption-distribution").textContent =
        `${m.label} by primary topic · ${distScope}`;
      dataTable(
        "data-distribution",
        ["Topic", m.label],
        perTopic.map((d) => [d.topic, fmt(d.value)])
      );
      mount(
        "plot-distribution",
        Plot.plot({
          width: widthOf("panel-distribution"),
          height: perTopic.length * 26 + 54,
          marginLeft: 200,
          style: { fontSize: "12.5px" },
          x: {
            label: m.label,
            grid: true,
            nice: true,
            ...valScale(m, Math.max(0, ...perTopic.map((d) => d.value))),
          },
          y: { label: null },
          marks: [
            Plot.barX(perTopic, {
              x: "value",
              y: "topic",
              rx: barRx(),
              sort: { y: "-x" },
              fill: (d) => topicColor.get(d.id),
              tip: true,
            }),
          ],
        })
      );

      // B2 · topic share donut — every topic, scoped by year only, so it
      // reads as a share of the whole; the selection just colours the ring.
      const shareScope = sessionCells.filter((c) => yearIn(c.year));
      const allTopics = topics
        .map((t) => ({
          topic: t.title,
          id: t.id,
          value: shareScope.filter((c) => c.topicId === t.id).reduce((n, c) => n + m.of(c), 0),
        }))
        .filter((d) => d.value > 0)
        .sort((a, b) => b.value - a.value);
      const shareTotal = allTopics.reduce((n, d) => n + d.value, 0);
      document.getElementById("caption-share").textContent =
        `${m.label} share by topic · ${distScope}`;
      dataTable(
        "data-share",
        ["Topic", m.label, "Share"],
        allTopics.map((d) => [
          d.topic,
          fmt(d.value),
          shareTotal ? `${Math.round((d.value / shareTotal) * 100)}%` : "—",
        ])
      );
      mount(
        "plot-share",
        donutChart(allTopics, {
          width: widthOf("panel-share"),
          total: shareTotal,
          measureLabel: m.label,
          scopeLabel: distScope,
        })
      );

      // C · topic lines across years — the year selection narrows the span.
      const sel = F().years.size ? [...F().years].sort((a, b) => a - b) : null;
      const yMin = sel ? sel[0] : years[0];
      const yMax = sel ? sel.at(-1) : years.at(-1);
      const spanYears = years.filter((y) => y >= yMin && y <= yMax);
      const single = yMin === yMax;
      const lineData = cells
        .filter((c) => c.year >= yMin && c.year <= yMax)
        .map((c) => ({
          year: c.year,
          topic: topicTitle.get(c.topicId) ?? "—",
          id: c.topicId,
          value: m.of(c),
        }));
      document.getElementById("caption-lines").textContent =
        `${m.label} per primary topic across years`;
      dataTable(
        "data-lines",
        ["Topic", ...years.map(shortYear)],
        topics
          .filter((t) => active.has(t.id))
          .map((t) => [
            t.title,
            ...years.map((y) =>
              fmt(
                cells
                  .filter((c) => c.topicId === t.id && c.year === y)
                  .reduce((n, c) => n + m.of(c), 0)
              )
            ),
          ])
      );
      mount(
        "plot-lines",
        Plot.plot({
          width: widthOf("panel-lines"),
          height: 340,
          marginLeft: 46,
          style: { fontSize: "12.5px" },
          x: {
            tickFormat: shortYear,
            label: null,
            ticks: spanYears,
            domain: single ? [yMin - 0.5, yMax + 0.5] : [yMin, yMax],
          },
          y: {
            label: m.label,
            grid: true,
            nice: true,
            ...valScale(m, Math.max(0, ...lineData.map((d) => d.value))),
          },
          marks: [
            F().years.size
              ? Plot.ruleX([...F().years], { stroke: css("--ink"), strokeDasharray: "3,3" })
              : null,
            Plot.line(lineData, {
              x: "year",
              y: "value",
              z: "topic",
              stroke: (d) => colorOf(d.id),
              strokeWidth: 1.8,
              curve: "monotone-x",
            }),
            Plot.dot(lineData, {
              x: "year",
              y: "value",
              z: "topic",
              fill: (d) => topicColor.get(d.id),
              r: 2.5,
              tip: { format: { x: (y) => yearLabel(y) } },
              channels: { topic: "topic" },
            }),
            // One glyph at each line's end as identifier; endpoints are
            // nudged apart so they never stack. Black line art, so skipped
            // on dark themes.
            !(document.documentElement.dataset.theme ?? "").includes("night")
              ? Plot.image(
                  (() => {
                    const ends = Object.values(
                      lineData.reduce((acc, d) => {
                        if (!acc[d.id] || d.year > acc[d.id].year) acc[d.id] = { ...d };
                        return acc;
                      }, {})
                    ).sort((a, b) => a.value - b.value);
                    const maxVal = Math.max(1, ...lineData.map((d) => d.value));
                    const sep = (maxVal * 17) / 280; // ≈17px in data units
                    let prev = -Infinity;
                    for (const e of ends) {
                      e.iconY = Math.max(e.value, prev + sep);
                      prev = e.iconY;
                    }
                    return ends;
                  })(),
                  {
                    x: "year",
                    y: "iconY",
                    src: (d) => topicGlyph.get(d.id),
                    width: 15,
                    height: 15,
                    dx: 12,
                  }
                )
              : null,
          ].filter(Boolean),
        })
      );

      renderCrossSection();
    }

    render();
    let resizeTimer;
    addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(render, 150);
    });
    addEventListener("dh-theme", render);
    addEventListener("dh-filter", () => {
      state.expanded = false;
      render();
    });
  </script>
</Base>

<style is:global>
  .observatory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem 2.5rem;
  }

  .panel {
    margin: 0;
    border-top: 2px solid var(--ink);
    padding-top: 0.6rem;
    min-width: 0;
  }

  .panel.wide {
    grid-column: 1 / -1;
  }

  .panel .plot svg {
    background: transparent !important;
    font-family: var(--font-mono) !important;
  }

  .donut-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: 0.4rem;
  }

  .donut {
    display: block;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }

  .donut-slice path {
    stroke: var(--paper);
    stroke-width: 1.5;
    cursor: pointer;
    transition: opacity 150ms ease;
  }

  .donut-slice.dim {
    opacity: 0.62;
  }

  .donut-slice:hover path {
    opacity: 0.85;
  }

  /* The glyphs are black line art served from Apple's CDN (cross-origin), and
     CSS filters don't reliably recolour cross-origin <image> across browsers.
     So the badge is a constant light disc and the glyph stays its native dark:
     readable on every theme and every slice colour, filter or no filter. */
  .donut-badge {
    fill: #f3ecdb;
    stroke: rgba(0, 0, 0, 0.22);
    stroke-width: 0.75;
    pointer-events: none;
  }

  /* brightness(0) flattens the glyph to a black silhouette regardless of the
     theme or the source SVG's own colours — deterministic, never inverts the
     wrong way, and always reads on the light badge. (It also forces the
     cross-origin <image> to rasterise, which a bare element skips.) */
  .donut-glyph {
    filter: brightness(0);
    pointer-events: none;
  }

  .donut-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    padding: 0 24%;
    text-align: center;
    pointer-events: none;
  }

  .donut-center strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.1;
  }

  .donut-center span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--lede-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .donut-slice path {
      transition: none;
    }
  }

  .cross-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.5rem;
    margin-block: 0.6rem 0.8rem;
  }

  #cross-summary {
    margin-block: 0 1rem;
  }
</style>
