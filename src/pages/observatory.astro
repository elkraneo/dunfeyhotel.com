---
import Base from "../layouts/Base.astro";
---

<Base
  title="Observatory"
  description="Coordinated, explorable views of thirteen years of WWDC — and every cross-section materializes as an actionable list of sessions and resources."
  wide
  searchable={false}
>
  <section class="hero">
    <p class="kicker">The observatory</p>
    <h1>Correlate, then collect.</h1>
    <p class="lede">
      Year, topics, measure — the panels answer together; the cross-section
      below lists the results. The view lives in the URL.
    </p>
  </section>

  <div class="controls" role="group" aria-label="Observatory controls">
    <fieldset class="lens">
      <legend class="kicker">Measure</legend>
      <label><input type="radio" name="measure" value="sessions" checked /> Sessions</label>
      <label><input type="radio" name="measure" value="hours" /> Hours</label>
      <label><input type="radio" name="measure" value="snippets" /> Code snippets</label>
    </fieldset>
  </div>

  <div class="observatory-grid" data-dh-reactive>
    <figure class="panel" id="panel-years">
      <figcaption class="kicker" id="caption-years"></figcaption>
      <div class="view-toggle" role="group" aria-label="Show as">
        <button type="button" class="chip" data-view="chart" aria-pressed="true">Chart</button>
        <button type="button" class="chip" data-view="table" aria-pressed="false">Table</button>
      </div>
      <div class="plot" id="plot-years"></div>
      <div class="chart-table" id="data-years" hidden></div>
    </figure>
    <figure class="panel" id="panel-distribution">
      <figcaption class="kicker" id="caption-distribution"></figcaption>
      <div class="view-toggle" role="group" aria-label="Show as">
        <button type="button" class="chip" data-view="chart" aria-pressed="true">Chart</button>
        <button type="button" class="chip" data-view="table" aria-pressed="false">Table</button>
      </div>
      <div class="plot" id="plot-distribution"></div>
      <div class="chart-table" id="data-distribution" hidden></div>
    </figure>
    <figure class="panel wide" id="panel-lines">
      <figcaption class="kicker" id="caption-lines"></figcaption>
      <div class="view-toggle" role="group" aria-label="Show as">
        <button type="button" class="chip" data-view="chart" aria-pressed="true">Chart</button>
        <button type="button" class="chip" data-view="table" aria-pressed="false">Table</button>
      </div>
      <div class="plot" id="plot-lines"></div>
      <div class="chart-table" id="data-lines" hidden></div>
    </figure>
  </div>

  <section class="block" aria-labelledby="cross-section" id="cross-section-block">
    <h2 class="kicker" id="cross-section">Cross-section</h2>
    <div class="cross-controls">
      <div class="chip-row" role="group" aria-label="Collect as" id="kind-chips"></div>
      <div class="chip-row" role="group" aria-label="Display" id="view-chips">
        <button type="button" class="chip" data-view="list" aria-pressed="true">List</button>
        <button type="button" class="chip" data-view="grid" aria-pressed="false">Grid</button>
      </div>
      <label class="meta" for="cross-sort">
        Sort
        <select id="cross-sort" class="theme-select"></select>
      </label>
    </div>
    <p class="meta" id="cross-summary" role="status"></p>
    <div id="cross-results"></div>
    <p><button type="button" class="watch secondary" id="cross-more" hidden>Show everything</button></p>
  </section>

  <p class="footnote">
    Charts count by primary topic; the cross-section matches any active topic.
    Pre-2019 years reflect what Apple still publishes. Charts:
    <a href="https://observablehq.com/plot/">Observable Plot</a>.
  </p>

  <script>
    import * as Plot from "@observablehq/plot";
    import explorer from "../../data/normalized/explorer.json";
    import index from "../../data/normalized/observatory-index.json";

    const { years, topics, sessionCells } = explorer;
    const { sessions, resources } = index;
    const resourceById = new Map(resources.map((r) => [r.id, r]));

    // 19 hues per theme: distinguishable from each other, ≥4.5:1 for white
    // chip text, and matched to each theme's paper.
    const PALETTES = {
      ledger: [
        "#8c1d22", "#9a6b1f", "#2f6f3e", "#1f4e79", "#b3541e",
        "#6d3e8e", "#0f766e", "#c43e4b", "#5a6e1f", "#2e7fb8",
        "#a34708", "#4a44a8", "#1f8a55", "#a23a78", "#8a7a14",
        "#176d8c", "#9c5230", "#6a7a2a", "#5d3a9b",
      ],
      night: [
        "#e2858d", "#d9b35e", "#8fbf94", "#85a8d4", "#e0a268",
        "#c49ad4", "#6fc7be", "#ef8f98", "#b9cb8c", "#94bee0",
        "#e99d62", "#aba5df", "#7fd0a7", "#d88fb6", "#cfbe65",
        "#8ac4dc", "#e19a7a", "#b8c37a", "#b49be0",
      ],
      cupertino: [
        "#d70015", "#c93400", "#937400", "#248a3d", "#0c817b",
        "#008299", "#0071a4", "#0040dd", "#3634a3", "#8944ab",
        "#d30f45", "#7f6545", "#365314", "#155e75", "#9d174d",
        "#4d7c0f", "#5b21b6", "#b25000", "#0f766e",
      ],
      "cupertino-night": [
        "#ff453a", "#ff9f0a", "#ffd60a", "#32d74b", "#66d4cf",
        "#5ac8f5", "#64d2ff", "#0a84ff", "#7d7aff", "#bf5af2",
        "#ff375f", "#ac8e68", "#a2d149", "#63e6e2", "#ff6482",
        "#8fd158", "#5e5ce6", "#ffb340", "#30d158",
      ],
    };
    const topicIndex = new Map(topics.map((t, i) => [t.id, i]));
    const palette = () => {
      const theme = document.documentElement.dataset.theme;
      return PALETTES[theme] ?? PALETTES.ledger;
    };
    const colorOf = (topicId) => {
      const p = palette();
      return p[topicIndex.get(topicId) % p.length];
    };
    const topicColor = { get: colorOf };
    const topicTitle = new Map(topics.map((t) => [t.id, t.title]));
    const topicGlyph = new Map(topics.map((t) => [t.id, t.glyph]));
    const slugOf = (title) =>
      title.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    const topicBySlug = new Map(topics.map((t) => [slugOf(t.title), t]));

    const MEASURES = {
      sessions: { label: "sessions", of: (c) => c.sessions },
      hours: { label: "hours", of: (c) => c.seconds / 3600 },
      snippets: { label: "code snippets", of: (c) => c.snippets },
    };
    const KINDS = [
      { key: "sessions", label: "Sessions" },
      { key: "samplecode", label: "Sample code" },
      { key: "documentation", label: "Documentation" },
      { key: "guide", label: "Guides" },
      { key: "download", label: "Downloads" },
    ];
    const SESSION_SORTS = {
      newest: { label: "Newest", fn: (a, b) => b.y - a.y || b.d - a.d },
      oldest: { label: "Oldest", fn: (a, b) => a.y - b.y || b.d - a.d },
      longest: { label: "Longest", fn: (a, b) => b.d - a.d },
      code: { label: "Most code", fn: (a, b) => b.c - a.c },
      title: { label: "Title A–Z", fn: (a, b) => a.t.localeCompare(b.t) },
    };
    const RESOURCE_SORTS = {
      title: { label: "Title A–Z", fn: (a, b) => a.r.t.localeCompare(b.r.t) },
      cited: { label: "Most cited", fn: (a, b) => b.by.length - a.by.length },
    };

    // ——— state: years/topics/q live in the site-wide cross-section bar
    // (window.dhFilter); this page owns only measure, kind and sort. ———
    const params = new URLSearchParams(location.search);
    const state = {
      measure: MEASURES[params.get("measure")] ? params.get("measure") : "sessions",
      kind: KINDS.some((k) => k.key === params.get("kind")) ? params.get("kind") : "sessions",
      sort: params.get("sort"),
      view: params.get("view") === "grid" ? "grid" : "list",
      expanded: false,
    };
    const F = () => window.dhFilter ?? { years: new Set(), topics: new Set(), q: "" };
    const activeSet = () => {
      const f = F();
      return f.topics.size ? f.topics : new Set(topics.map((t) => t.id));
    };

    function syncURL() {
      const p = new URLSearchParams(location.search);
      state.measure !== "sessions" ? p.set("measure", state.measure) : p.delete("measure");
      state.kind !== "sessions" ? p.set("kind", state.kind) : p.delete("kind");
      state.sort ? p.set("sort", state.sort) : p.delete("sort");
      state.view === "grid" ? p.set("view", "grid") : p.delete("view");
      history.replaceState(null, "", p.size ? `?${p}` : location.pathname);
    }

    const barRx = () =>
      (document.documentElement.dataset.theme ?? "").startsWith("cupertino") ? 4 : 0;
    const css = (name) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const fmt = (n) => Math.round(n).toLocaleString("en");
    const yearLabel = (y) => `WWDC${String(y).slice(2)}`;
    const shortYear = (y) => `’${String(y).slice(2)}`;
    const minutes = (d) => (d ? `${Math.round(d / 60)} min` : "—");
    const yearIn = (y) => {
      const f = F();
      return f.years.size === 0 || f.years.has(y);
    };
    const yearScope = () => {
      const f = F();
      return f.years.size ? [...f.years].sort().map(shortYear).join("+") : null;
    };

    // ——— controls ———
    document.querySelectorAll('input[name="measure"]').forEach((input) => {
      input.checked = input.value === state.measure;
      input.addEventListener("change", () => {
        state.measure = input.value;
        render();
      });
    });

    const kindChips = document.getElementById("kind-chips");
    for (const k of KINDS) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip";
      b.textContent = k.label;
      b.addEventListener("click", () => {
        state.kind = k.key;
        state.sort = null;
        state.expanded = false;
        render();
      });
      b.dataset.kind = k.key;
      kindChips.append(b);
    }

    const viewChips = document.getElementById("view-chips");
    viewChips.querySelectorAll(".chip").forEach((b) =>
      b.addEventListener("click", () => {
        state.view = b.dataset.view;
        render();
      })
    );

    const sortSelect = document.getElementById("cross-sort");
    sortSelect.addEventListener("change", () => {
      state.sort = sortSelect.value;
      state.expanded = false;
      render();
    });
    function syncSortOptions() {
      const sorts = state.kind === "sessions" ? SESSION_SORTS : RESOURCE_SORTS;
      const fallback = state.kind === "sessions" ? "newest" : "title";
      if (!sorts[state.sort]) state.sort = fallback;
      sortSelect.replaceChildren(
        ...Object.entries(sorts).map(([key, s]) => {
          const o = document.createElement("option");
          o.value = key;
          o.textContent = s.label;
          o.selected = key === state.sort;
          return o;
        })
      );
      return sorts[state.sort].fn;
    }

    const moreButton = document.getElementById("cross-more");
    moreButton.addEventListener("click", () => {
      state.expanded = true;
      render();
    });

    // Chart ⇄ table per panel — both views are first-class.
    document.querySelectorAll(".panel .view-toggle").forEach((group) => {
      const panel = group.closest(".panel");
      group.querySelectorAll(".chip").forEach((btn) =>
        btn.addEventListener("click", () => {
          const view = btn.dataset.view;
          group
            .querySelectorAll(".chip")
            .forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          panel.querySelector(".plot").hidden = view !== "chart";
          panel.querySelector(".chart-table").hidden = view !== "table";
        })
      );
    });

    // ——— rendering ———
    // Charts are presentational (aria-hidden); the same data is always
    // available as a real table right under each panel.
    const mount = (id, node) => {
      node.setAttribute("aria-hidden", "true");
      document.getElementById(id).replaceChildren(node);
    };
    const esc = (v) =>
      String(v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const dataTable = (id, headers, rows) => {
      document.getElementById(id).innerHTML = `<table class="ledger">
        <thead><tr>${headers.map((h) => `<th scope="col">${esc(h)}</th>`).join("")}</tr></thead>
        <tbody>${rows
          .map(
            (r) =>
              `<tr>${r
                .map((c, i) =>
                  i === 0 ? `<th scope="row">${esc(c)}</th>` : `<td class="num">${esc(c)}</td>`
                )
                .join("")}</tr>`
          )
          .join("")}</tbody>
      </table>`;
    };
    const PREVIEW = 24;

    function matchingSessions() {
      const active = activeSet();
      const q = F().q.toLowerCase();
      return sessions.filter(
        (s) =>
          yearIn(s.y) &&
          s.k.some((id) => active.has(id)) &&
          (!q || s.t.toLowerCase().includes(q))
      );
    }

    function renderCrossSection() {
      const matched = matchingSessions();
      const summary = document.getElementById("cross-summary");
      const results = document.getElementById("cross-results");

      kindChips.querySelectorAll(".chip").forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.kind === state.kind))
      );
      viewChips.hidden = state.kind !== "sessions";
      viewChips.querySelectorAll(".chip").forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.view === state.view))
      );

      const sortFn = syncSortOptions();
      if (state.kind === "sessions") {
        const list = [...matched].sort(sortFn);
        const visible = state.expanded ? list : list.slice(0, PREVIEW);
        summary.textContent = `${list.length} sessions matching any active topic${yearScope() ? ` · ${yearScope()}` : ""}`;
        const grid = state.view === "grid";
        const rows = document.createElement(grid ? "div" : "ul");
        rows.className = grid ? "gcards" : "session-rows";
        visible.forEach((s, i) => {
          const snips = s.c ? ` · ${s.c} ${s.c === 1 ? "snippet" : "snippets"}` : "";
          const row = document.createElement(grid ? "div" : "li");
          row.className = (grid ? "gcard" : "session-row") + " appear";
          row.style.animationDelay = `${Math.min(i * 22, 440)}ms`;
          if (grid) {
            row.innerHTML = `
              ${s.img ? `<img class="gcard-thumb" src="${s.img}" alt="" loading="lazy" width="250" height="141" onerror="this.remove()">` : ""}
              <h3><a href="/sessions/${s.id}/"></a></h3>
              <p class="meta">${yearLabel(s.y)} · ${minutes(s.d)}${snips}</p>`;
          } else {
            row.innerHTML = `
              ${s.img ? `<img class="row-thumb" src="${s.img}" alt="" loading="lazy" width="104" height="59" onerror="this.remove()">` : ""}
              <div class="row-body">
                <h3><a href="/sessions/${s.id}/"></a></h3>
                <p class="meta">${yearLabel(s.y)}${snips}</p>
              </div>
              <span class="row-leader" aria-hidden="true"></span>
              <span class="row-duration">${minutes(s.d)}</span>`;
          }
          row.querySelector("a").textContent = s.t;
          rows.append(row);
        });
        mount("cross-results", rows);
        moreButton.hidden = state.expanded || list.length <= PREVIEW;
        moreButton.textContent = `Show all ${list.length}`;
      } else {
        const seen = new Map();
        for (const s of matched) {
          for (const rid of s.r) {
            const r = resourceById.get(rid);
            if (!r || r.type !== state.kind) continue;
            const entry = seen.get(rid) ?? { r, by: [] };
            entry.by.push(s);
            seen.set(rid, entry);
          }
        }
        const list = [...seen.values()].sort(sortFn);
        const visible = state.expanded ? list : list.slice(0, PREVIEW * 2);
        summary.textContent = `${list.length} ${KINDS.find((k) => k.key === state.kind).label.toLowerCase()}${yearScope() ? ` · ${yearScope()}` : ""}`;
        const ul = document.createElement("ul");
        ul.className = "plain";
        for (const { r, by } of visible) {
          const li = document.createElement("li");
          const link = document.createElement("a");
          link.href = r.u;
          link.rel = "external";
          link.innerHTML = `<strong></strong>`;
          link.querySelector("strong").textContent = r.t;
          li.append(link);
          const meta = document.createElement("span");
          meta.className = "meta";
          meta.append(" · in ");
          by.slice(0, 4).forEach((s, i) => {
            if (i) meta.append(", ");
            const a = document.createElement("a");
            a.href = `/sessions/${s.id}/`;
            a.title = s.t;
            a.textContent = `${shortYear(s.y)} §${s.id.split("-")[1]}`;
            meta.append(a);
          });
          if (by.length > 4) meta.append(` +${by.length - 4}`);
          li.append(meta);
          ul.append(li);
        }
        mount("cross-results", ul);
        moreButton.hidden = state.expanded || list.length <= PREVIEW * 2;
        moreButton.textContent = `Show all ${list.length}`;
      }
    }

    function render() {
      syncURL();
      const m = MEASURES[state.measure];
      const active = activeSet();
      const cells = sessionCells.filter((c) => active.has(c.topicId));
      const widthOf = (id) => Math.max(280, document.getElementById(id).clientWidth - 8);
      const width = widthOf("panel-years");
      const tipYear = { format: { x: (y) => yearLabel(y) } };


      // A · measure per year
      const perYear = years.map((year) => ({
        year,
        value: cells.filter((c) => c.year === year).reduce((n, c) => n + m.of(c), 0),
      }));
      const total = perYear
        .filter((d) => yearIn(d.year))
        .reduce((n, d) => n + d.value, 0);
      document.getElementById("caption-years").textContent =
        `${m.label} by year, primary topic · ${fmt(total)} ${yearScope() ?? "total"}`;
      mount(
        "plot-years",
        Plot.plot({
          width,
          height: 220,
          marginLeft: 46,
          style: { fontSize: "12.5px" },
          x: { tickFormat: shortYear, label: null, type: "band" },
          y: { label: m.label, grid: true, nice: true },
          marks: [
            Plot.barY(perYear, {
              x: "year",
              y: "value",
              rx: barRx(),
              fill: (d) => (yearIn(d.year) ? css("--oxblood") : css("--bar-muted")),
              tip: tipYear,
            }),
          ],
        })
      );
      dataTable(
        "data-years",
        ["Year", m.label],
        perYear.map((d) => [yearLabel(d.year), fmt(d.value)])
      );

      // B · distribution across topics
      const scope = cells.filter((c) => yearIn(c.year));
      const perTopic = topics
        .filter((t) => active.has(t.id))
        .map((t) => ({
          topic: t.title,
          id: t.id,
          value: scope.filter((c) => c.topicId === t.id).reduce((n, c) => n + m.of(c), 0),
        }))
        .filter((d) => d.value > 0)
        .sort((a, b) => b.value - a.value);
      document.getElementById("caption-distribution").textContent =
        `${m.label} by primary topic · ${yearScope() ?? "all years"}`;
      dataTable(
        "data-distribution",
        ["Topic", m.label],
        perTopic.map((d) => [d.topic, fmt(d.value)])
      );
      mount(
        "plot-distribution",
        Plot.plot({
          width: widthOf("panel-distribution"),
          height: perTopic.length * 26 + 54,
          marginLeft: 200,
          style: { fontSize: "12.5px" },
          x: { label: m.label, grid: true, nice: true },
          y: { label: null },
          marks: [
            Plot.barX(perTopic, {
              x: "value",
              y: "topic",
              rx: barRx(),
              sort: { y: "-x" },
              fill: (d) => topicColor.get(d.id),
              tip: true,
            }),
          ],
        })
      );

      // C · topic lines across years — the year selection narrows the span.
      const sel = F().years.size ? [...F().years].sort((a, b) => a - b) : null;
      const yMin = sel ? sel[0] : years[0];
      const yMax = sel ? sel.at(-1) : years.at(-1);
      const spanYears = years.filter((y) => y >= yMin && y <= yMax);
      const single = yMin === yMax;
      const lineData = cells
        .filter((c) => c.year >= yMin && c.year <= yMax)
        .map((c) => ({
          year: c.year,
          topic: topicTitle.get(c.topicId) ?? "—",
          id: c.topicId,
          value: m.of(c),
        }));
      document.getElementById("caption-lines").textContent =
        `${m.label} per primary topic across years`;
      dataTable(
        "data-lines",
        ["Topic", ...years.map(shortYear)],
        topics
          .filter((t) => active.has(t.id))
          .map((t) => [
            t.title,
            ...years.map((y) =>
              fmt(
                cells
                  .filter((c) => c.topicId === t.id && c.year === y)
                  .reduce((n, c) => n + m.of(c), 0)
              )
            ),
          ])
      );
      mount(
        "plot-lines",
        Plot.plot({
          width: widthOf("panel-lines"),
          height: 340,
          marginLeft: 46,
          style: { fontSize: "12.5px" },
          x: {
            tickFormat: shortYear,
            label: null,
            ticks: spanYears,
            domain: single ? [yMin - 0.5, yMax + 0.5] : [yMin, yMax],
          },
          y: { label: m.label, grid: true, nice: true },
          marks: [
            F().years.size
              ? Plot.ruleX([...F().years], { stroke: css("--ink"), strokeDasharray: "3,3" })
              : null,
            Plot.line(lineData, {
              x: "year",
              y: "value",
              z: "topic",
              stroke: (d) => colorOf(d.id),
              strokeWidth: 1.8,
              curve: "monotone-x",
            }),
            Plot.dot(lineData, {
              x: "year",
              y: "value",
              z: "topic",
              fill: (d) => topicColor.get(d.id),
              r: 2.5,
              tip: { format: { x: (y) => yearLabel(y) } },
              channels: { topic: "topic" },
            }),
            // One glyph at each line's end as identifier; endpoints are
            // nudged apart so they never stack. Black line art, so skipped
            // on dark themes.
            !(document.documentElement.dataset.theme ?? "").includes("night")
              ? Plot.image(
                  (() => {
                    const ends = Object.values(
                      lineData.reduce((acc, d) => {
                        if (!acc[d.id] || d.year > acc[d.id].year) acc[d.id] = { ...d };
                        return acc;
                      }, {})
                    ).sort((a, b) => a.value - b.value);
                    const maxVal = Math.max(1, ...lineData.map((d) => d.value));
                    const sep = (maxVal * 17) / 280; // ≈17px in data units
                    let prev = -Infinity;
                    for (const e of ends) {
                      e.iconY = Math.max(e.value, prev + sep);
                      prev = e.iconY;
                    }
                    return ends;
                  })(),
                  {
                    x: "year",
                    y: "iconY",
                    src: (d) => topicGlyph.get(d.id),
                    width: 15,
                    height: 15,
                    dx: 12,
                  }
                )
              : null,
          ].filter(Boolean),
        })
      );

      renderCrossSection();
    }

    render();
    let resizeTimer;
    addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(render, 150);
    });
    addEventListener("dh-theme", render);
    addEventListener("dh-filter", () => {
      state.expanded = false;
      render();
