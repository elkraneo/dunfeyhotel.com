---
import Base from "../layouts/Base.astro";
---

<Base
  title="Observatory"
  description="Coordinated, explorable views of thirteen years of WWDC — and every cross-section materializes as an actionable list of sessions and resources."
>
  <section class="hero">
    <p class="kicker">The observatory</p>
    <h1>Correlate, then collect.</h1>
    <p class="lede">
      Pick a year, toggle topics, switch the measure — every panel answers
      together, and the cross-section below materializes as the actual
      sessions and resources, ready to open. The view is in the URL: share it.
    </p>
  </section>

  <div class="controls" role="group" aria-label="Observatory controls">
    <fieldset class="lens">
      <legend class="kicker">Measure</legend>
      <label><input type="radio" name="measure" value="sessions" checked /> Sessions</label>
      <label><input type="radio" name="measure" value="hours" /> Hours</label>
      <label><input type="radio" name="measure" value="snippets" /> Code snippets</label>
    </fieldset>
    <div class="lens">
      <p class="kicker" id="years-label">Year</p>
      <div class="chip-row" role="group" aria-labelledby="years-label" id="year-chips"></div>
    </div>
    <div class="lens">
      <p class="kicker" id="topics-label">
        Topics · <button type="button" class="linkish" id="topics-all">all</button> ·
        <button type="button" class="linkish" id="topics-none">none</button>
      </p>
      <div class="chip-row" role="group" aria-labelledby="topics-label" id="topic-chips"></div>
    </div>
  </div>

  <div class="observatory-grid">
    <figure class="panel" id="panel-years">
      <figcaption class="kicker" id="caption-years"></figcaption>
      <div class="plot" id="plot-years"></div>
      <details class="chart-data">
        <summary>Same data as table</summary>
        <div id="data-years"></div>
      </details>
    </figure>
    <figure class="panel" id="panel-distribution">
      <figcaption class="kicker" id="caption-distribution"></figcaption>
      <div class="plot" id="plot-distribution"></div>
      <details class="chart-data">
        <summary>Same data as table</summary>
        <div id="data-distribution"></div>
      </details>
    </figure>
    <figure class="panel wide" id="panel-lines">
      <figcaption class="kicker" id="caption-lines"></figcaption>
      <div class="plot" id="plot-lines"></div>
      <details class="chart-data">
        <summary>Same data as table</summary>
        <div id="data-lines"></div>
      </details>
    </figure>
  </div>

  <section class="block" aria-labelledby="cross-section" id="cross-section-block">
    <h2 class="kicker" id="cross-section">Cross-section</h2>
    <div class="chip-row" role="group" aria-label="Collect as" id="kind-chips"></div>
    <p class="meta" id="cross-summary" role="status"></p>
    <div id="cross-results"></div>
    <p><button type="button" class="watch secondary" id="cross-more" hidden>Show everything</button></p>
  </section>

  <p class="footnote">
    Counts attribute each talk to its primary topic; resources are collected
    from every session in the cross-section. Years before 2019 reflect the
    catalog Apple still publishes. Charts render with
    <a href="https://observablehq.com/plot/">Observable Plot</a>.
  </p>

  <script>
    import * as Plot from "@observablehq/plot";
    import explorer from "../../data/normalized/explorer.json";
    import index from "../../data/normalized/observatory-index.json";

    const { years, topics, sessionCells } = explorer;
    const { sessions, resources } = index;
    const resourceById = new Map(resources.map((r) => [r.id, r]));

    // 19 hues per theme: dark inks for light papers, lifted tones for night.
    const PALETTES = {
      ledger: [
        "#6e2228", "#7d5e20", "#3d5a3f", "#2f4b6e", "#7a4a21",
        "#5b3a68", "#205e5a", "#8d2f36", "#576238", "#386083",
        "#8c4214", "#44406e", "#226b45", "#703354", "#665818",
        "#2c5f73", "#84422c", "#4f5526", "#503e72",
      ],
      night: [
        "#d4737c", "#c9a14e", "#8fbf94", "#85a8d4", "#cf9258",
        "#b38ac4", "#6fbcb4", "#df8089", "#a9bb7c", "#84aed0",
        "#d98d52", "#9b95cf", "#6fc097", "#c87fa6", "#bfae55",
        "#7ab4cc", "#d18a6a", "#a8b36a", "#a48bd0",
      ],
    };
    const topicIndex = new Map(topics.map((t, i) => [t.id, i]));
    const palette = () => {
      const theme = document.documentElement.dataset.theme;
      return PALETTES[theme] ?? PALETTES.ledger;
    };
    const colorOf = (topicId) => {
      const p = palette();
      return p[topicIndex.get(topicId) % p.length];
    };
    const topicColor = { get: colorOf };
    const topicTitle = new Map(topics.map((t) => [t.id, t.title]));
    const slugOf = (title) =>
      title.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    const topicBySlug = new Map(topics.map((t) => [slugOf(t.title), t]));

    const MEASURES = {
      sessions: { label: "sessions", of: (c) => c.sessions },
      hours: { label: "hours", of: (c) => c.seconds / 3600 },
      snippets: { label: "code snippets", of: (c) => c.snippets },
    };
    const KINDS = [
      { key: "sessions", label: "Sessions" },
      { key: "samplecode", label: "Sample code" },
      { key: "documentation", label: "Documentation" },
      { key: "guide", label: "Guides" },
      { key: "download", label: "Downloads" },
    ];

    // ——— state, hydrated from the URL ———
    const params = new URLSearchParams(location.search);
    const state = {
      measure: MEASURES[params.get("measure")] ? params.get("measure") : "sessions",
      year: years.includes(Number(params.get("year"))) ? Number(params.get("year")) : null,
      active: new Set(
        params.get("topics")
          ? params.get("topics").split(",").map((s) => topicBySlug.get(s)?.id).filter(Boolean)
          : topics.map((t) => t.id)
      ),
      kind: KINDS.some((k) => k.key === params.get("kind")) ? params.get("kind") : "sessions",
      expanded: false,
    };
    if (state.active.size === 0) state.active = new Set(topics.map((t) => t.id));

    function syncURL() {
      const p = new URLSearchParams();
      if (state.measure !== "sessions") p.set("measure", state.measure);
      if (state.year) p.set("year", state.year);
      if (state.active.size < topics.length)
        p.set("topics", topics.filter((t) => state.active.has(t.id)).map((t) => slugOf(t.title)).join(","));
      if (state.kind !== "sessions") p.set("kind", state.kind);
      history.replaceState(null, "", p.size ? `?${p}` : location.pathname);
    }

    const css = (name) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const fmt = (n) => Math.round(n).toLocaleString("en");
    const yearLabel = (y) => `WWDC${String(y).slice(2)}`;
    const shortYear = (y) => `’${String(y).slice(2)}`;
    const minutes = (d) => (d ? `${Math.round(d / 60)} min` : "—");

    // ——— controls ———
    const yearChips = document.getElementById("year-chips");
    for (const y of [null, ...years]) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip fob";
      b.textContent = y === null ? "All years" : shortYear(y);
      b.addEventListener("click", () => {
        state.year = y;
        state.expanded = false;
        render();
      });
      b.dataset.year = y ?? "";
      yearChips.append(b);
    }

    const topicChips = document.getElementById("topic-chips");
    for (const t of topics) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip topic";
      b.style.setProperty("--chip-color", topicColor.get(t.id));
      if (t.glyph) {
        const img = document.createElement("img");
        img.src = t.glyph;
        img.alt = "";
        img.width = 12;
        img.height = 12;
        img.loading = "lazy";
        b.append(img);
      }
      b.append(` ${t.title}`);
      b.addEventListener("click", () => {
        state.active.has(t.id) ? state.active.delete(t.id) : state.active.add(t.id);
        state.expanded = false;
        render();
      });
      b.dataset.topic = t.id;
      topicChips.append(b);
    }
    document.getElementById("topics-all").addEventListener("click", () => {
      state.active = new Set(topics.map((t) => t.id));
      render();
    });
    document.getElementById("topics-none").addEventListener("click", () => {
      state.active.clear();
      render();
    });

    document.querySelectorAll('input[name="measure"]').forEach((input) => {
      input.checked = input.value === state.measure;
      input.addEventListener("change", () => {
        state.measure = input.value;
        render();
      });
    });

    const kindChips = document.getElementById("kind-chips");
    for (const k of KINDS) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip";
      b.textContent = k.label;
      b.addEventListener("click", () => {
        state.kind = k.key;
        state.expanded = false;
        render();
      });
      b.dataset.kind = k.key;
      kindChips.append(b);
    }

    const moreButton = document.getElementById("cross-more");
    moreButton.addEventListener("click", () => {
      state.expanded = true;
      render();
    });

    // ——— rendering ———
    // Charts are presentational (aria-hidden); the same data is always
    // available as a real table right under each panel.
    const mount = (id, node) => {
      node.setAttribute("aria-hidden", "true");
      document.getElementById(id).replaceChildren(node);
    };
    const esc = (v) =>
      String(v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const dataTable = (id, headers, rows) => {
      document.getElementById(id).innerHTML = `<table class="ledger">
        <thead><tr>${headers.map((h) => `<th scope="col">${esc(h)}</th>`).join("")}</tr></thead>
        <tbody>${rows
          .map(
            (r) =>
              `<tr>${r
                .map((c, i) =>
                  i === 0 ? `<th scope="row">${esc(c)}</th>` : `<td class="num">${esc(c)}</td>`
                )
                .join("")}</tr>`
          )
          .join("")}</tbody>
      </table>`;
    };
    const PREVIEW = 24;

    function matchingSessions() {
      return sessions.filter(
        (s) =>
          (state.year === null || s.y === state.year) &&
          s.k.some((id) => state.active.has(id))
      );
    }

    function renderCrossSection() {
      const matched = matchingSessions();
      const summary = document.getElementById("cross-summary");
      const results = document.getElementById("cross-results");

      kindChips.querySelectorAll(".chip").forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.kind === state.kind))
      );

      if (state.kind === "sessions") {
        const list = [...matched].sort((a, b) => b.y - a.y || b.d - a.d);
        const visible = state.expanded ? list : list.slice(0, PREVIEW);
        summary.textContent = `${list.length} sessions matching any active topic${state.year ? ` · ${yearLabel(state.year)}` : ""}`;
        const rows = document.createElement("ul");
        rows.className = "session-rows";
        visible.forEach((s, i) => {
          const row = document.createElement("li");
          row.className = "session-row appear";
          row.style.animationDelay = `${Math.min(i * 22, 440)}ms`;
          const snips = s.c ? ` · ${s.c} ${s.c === 1 ? "snippet" : "snippets"}` : "";
          row.innerHTML = `
            ${s.img ? `<img class="row-thumb" src="${s.img}" alt="" loading="lazy" width="104" height="59" onerror="this.remove()">` : ""}
            <div class="row-body">
              <h3><a href="/sessions/${s.id}/"></a></h3>
              <p class="meta">${yearLabel(s.y)}${snips}</p>
            </div>
            <span class="row-leader" aria-hidden="true"></span>
            <span class="row-duration">${minutes(s.d)}</span>`;
          row.querySelector("a").textContent = s.t;
          rows.append(row);
        });
        mount("cross-results", rows);
        moreButton.hidden = state.expanded || list.length <= PREVIEW;
        moreButton.textContent = `Show all ${list.length}`;
      } else {
        const seen = new Map();
        for (const s of matched) {
          for (const rid of s.r) {
            const r = resourceById.get(rid);
            if (!r || r.type !== state.kind) continue;
            const entry = seen.get(rid) ?? { r, by: [] };
            entry.by.push(s);
            seen.set(rid, entry);
          }
        }
        const list = [...seen.values()].sort((a, b) => a.r.t.localeCompare(b.r.t));
        const visible = state.expanded ? list : list.slice(0, PREVIEW * 2);
        summary.textContent = `${list.length} ${KINDS.find((k) => k.key === state.kind).label.toLowerCase()}${state.year ? ` · ${yearLabel(state.year)}` : ""}`;
        const ul = document.createElement("ul");
        ul.className = "plain";
        for (const { r, by } of visible) {
          const li = document.createElement("li");
          const link = document.createElement("a");
          link.href = r.u;
          link.rel = "external";
          link.innerHTML = `<strong></strong>`;
          link.querySelector("strong").textContent = r.t;
          li.append(link);
          const meta = document.createElement("span");
          meta.className = "meta";
          meta.append(" · in ");
          by.slice(0, 4).forEach((s, i) => {
            if (i) meta.append(", ");
            const a = document.createElement("a");
            a.href = `/sessions/${s.id}/`;
            a.title = s.t;
            a.textContent = `${shortYear(s.y)} §${s.id.split("-")[1]}`;
            meta.append(a);
          });
          if (by.length > 4) meta.append(` +${by.length - 4}`);
          li.append(meta);
          ul.append(li);
        }
        mount("cross-results", ul);
        moreButton.hidden = state.expanded || list.length <= PREVIEW * 2;
        moreButton.textContent = `Show all ${list.length}`;
      }
    }

    function render() {
      syncURL();
      const m = MEASURES[state.measure];
      const cells = sessionCells.filter((c) => state.active.has(c.topicId));
      const width = Math.min(640, document.getElementById("panel-years").clientWidth - 24);
      const tipYear = { format: { x: (y) => yearLabel(y) } };

      yearChips.querySelectorAll(".chip").forEach((b) => {
        const v = b.dataset.year === "" ? null : Number(b.dataset.year);
        b.setAttribute("aria-pressed", String(v === state.year));
      });
      topicChips.querySelectorAll(".chip").forEach((b) => {
        b.setAttribute("aria-pressed", String(state.active.has(Number(b.dataset.topic))));
        b.style.setProperty("--chip-color", colorOf(Number(b.dataset.topic)));
      });

      // A · measure per year
      const perYear = years.map((year) => ({
        year,
        value: cells.filter((c) => c.year === year).reduce((n, c) => n + m.of(c), 0),
      }));
      const total = perYear.reduce((n, d) => n + d.value, 0);
      document.getElementById("caption-years").textContent =
        `${m.label} by year, primary topic · ${fmt(state.year ? perYear.find((d) => d.year === state.year)?.value ?? 0 : total)} ${state.year ? yearLabel(state.year) : "total"}`;
      mount(
        "plot-years",
        Plot.plot({
          width,
          height: 220,
          marginLeft: 46,
          style: { fontSize: "12.5px" },
          x: { tickFormat: shortYear, label: null, type: "band" },
          y: { label: m.label, grid: true },
          marks: [
            Plot.barY(perYear, {
              x: "year",
              y: "value",
              fill: (d) =>
                state.year === null || d.year === state.year
                  ? css("--oxblood")
                  : css("--bar-muted"),
              tip: tipYear,
            }),
          ],
        })
      );
      dataTable(
        "data-years",
        ["Year", m.label],
        perYear.map((d) => [yearLabel(d.year), fmt(d.value)])
      );

      // B · distribution across topics
      const scope = state.year ? cells.filter((c) => c.year === state.year) : cells;
      const perTopic = topics
        .filter((t) => state.active.has(t.id))
        .map((t) => ({
          topic: t.title,
          id: t.id,
          value: scope.filter((c) => c.topicId === t.id).reduce((n, c) => n + m.of(c), 0),
        }))
        .filter((d) => d.value > 0)
        .sort((a, b) => b.value - a.value);
      document.getElementById("caption-distribution").textContent =
        `${m.label} by primary topic · ${state.year ? yearLabel(state.year) : "all years"}`;
      dataTable(
        "data-distribution",
        ["Topic", m.label],
        perTopic.map((d) => [d.topic, fmt(d.value)])
      );
      mount(
        "plot-distribution",
        Plot.plot({
          width,
          height: Math.max(160, perTopic.length * 24 + 44),
          marginLeft: 200,
          style: { fontSize: "12.5px" },
          x: { label: m.label, grid: true },
          y: { label: null },
          marks: [
            Plot.barX(perTopic, {
              x: "value",
              y: "topic",
              sort: { y: "-x" },
              fill: (d) => topicColor.get(d.id),
              tip: true,
            }),
          ],
        })
      );

      // C · topic lines across years
      const lineData = cells.map((c) => ({
        year: c.year,
        topic: topicTitle.get(c.topicId) ?? "—",
        id: c.topicId,
        value: m.of(c),
      }));
      document.getElementById("caption-lines").textContent =
        `${m.label} per primary topic across years`;
      dataTable(
        "data-lines",
        ["Topic", ...years.map(shortYear)],
        topics
          .filter((t) => state.active.has(t.id))
          .map((t) => [
            t.title,
            ...years.map((y) =>
              fmt(
                cells
                  .filter((c) => c.topicId === t.id && c.year === y)
                  .reduce((n, c) => n + m.of(c), 0)
              )
            ),
          ])
      );
      mount(
        "plot-lines",
        Plot.plot({
          width: Math.min(1100, document.getElementById("panel-lines").clientWidth - 24),
          height: 320,
          marginLeft: 46,
          style: { fontSize: "12.5px" },
          x: { tickFormat: shortYear, label: null },
          y: { label: m.label, grid: true },
          marks: [
            state.year ? Plot.ruleX([state.year], { stroke: css("--ink"), strokeDasharray: "3,3" }) : null,
            Plot.line(lineData, {
              x: "year",
              y: "value",
              z: "topic",
              stroke: (d) => colorOf(d.id),
              strokeWidth: 1.8,
              curve: "monotone-x",
            }),
            Plot.dot(lineData, {
              x: "year",
              y: "value",
              z: "topic",
              fill: (d) => topicColor.get(d.id),
              r: 2.5,
              tip: { format: { x: (y) => yearLabel(y) } },
              channels: { topic: "topic" },
            }),
          ].filter(Boolean),
        })
      );

      renderCrossSection();
    }

    render();
    let resizeTimer;
    addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(render, 150);
    });
    addEventListener("dh-theme", render);
  </script>
</Base>

<style is:global>
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem 2.5rem;
    padding: 1rem 0 1.4rem;
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: 1.5rem;
  }

  .lens {
    border: none;
    margin: 0;
    padding: 0;
  }

  .lens legend {
    padding: 0;
  }

  .lens label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-right: 1rem;
  }

  .linkish {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--oxblood);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    max-width: 46rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    padding: 0.28rem 0.65rem;
    cursor: pointer;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .chip img {
    display: inline-block;
  }

  .chip[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .chip[aria-pressed="true"] img {
    filter: invert(1);
  }

  .chip.topic[aria-pressed="true"] {
    background: var(--chip-color);
    border-color: var(--chip-color);
  }

  .observatory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem 2.5rem;
  }

  .panel {
    margin: 0;
    border-top: 2px solid var(--ink);
    padding-top: 0.6rem;
    min-width: 0;
  }

  .panel.wide {
    grid-column: 1 / -1;
  }

  .panel .plot svg {
    background: transparent !important;
    font-family: var(--font-mono) !important;
  }

  #kind-chips {
    margin-block: 0.6rem 0.8rem;
  }

  #cross-summary {
    margin-block: 0 1rem;
  }
</style>
