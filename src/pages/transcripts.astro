---
import Base from "../layouts/Base.astro";
import { sessions } from "../lib/data.js";

const total = sessions.filter((s) => s.hasTranscript).length;
---

<Base
  title="Transcripts"
  description={`Full transcripts for ${total.toLocaleString("en")} WWDC sessions — filter, then take them as .srt or plain text.`}
  wide
  searchable={false}
>
  <section class="hero">
    <p class="kicker">The record</p>
    <h1>Transcripts.</h1>
    <p class="lede">
      {total.toLocaleString("en")} sessions with full text. Filter, then take
      each as <code>.srt</code> or plain text — converted in your browser,
      straight from Apple's source.
    </p>
  </section>

  <div class="controls" role="group" aria-label="Transcript options">
    <div class="lens">
      <label class="kicker" for="t-lang">Language</label>
      <select id="t-lang" class="theme-select"></select>
    </div>
  </div>

  <p class="meta" id="t-count" role="status"></p>
  <table class="ledger" data-dh-reactive>
    <caption class="visually-hidden">Sessions with transcripts</caption>
    <thead>
      <tr>
        <th scope="col">№</th>
        <th scope="col">Session</th>
        <th scope="col">Topic</th>
        <th scope="col">Edition</th>
        <th scope="col" class="num">Min</th>
        <th scope="col" colspan="2">Download</th>
      </tr>
    </thead>
    <tbody id="t-rows"></tbody>
  </table>
  <p><button type="button" class="watch secondary" id="t-more" hidden>Show everything</button></p>

  <script>
    import indexJson from "../../data/normalized/observatory-index.json";
    import explorerJson from "../../data/normalized/explorer.json";
    import { LANG_NAMES, downloadTranscript } from "../lib/transcript-client.js";
    import type {
      ObservatoryIndex,
      ObservatorySession,
      Explorer,
      Topic,
    } from "../lib/types";

    const index = indexJson as unknown as ObservatoryIndex;
    const explorer = explorerJson as unknown as Explorer;
    const langNames = LANG_NAMES as Record<string, string>;
    const dhFilter = (): { years: Set<number>; topics: Set<number>; q: string } | undefined =>
      (window as unknown as {
        dhFilter?: { years: Set<number>; topics: Set<number>; q: string };
      }).dhFilter;

    const topicMeta = new Map<number, Topic>(
      explorer.topics.map((t: Topic) => [t.id, t])
    );
    const all = index.sessions
      .filter((s: ObservatorySession) => s.tr && Object.keys(s.trs ?? {}).length)
      .sort((a: ObservatorySession, b: ObservatorySession) => b.y - a.y || a.t.localeCompare(b.t));

    const langs = [...new Set(all.flatMap((s: ObservatorySession) => Object.keys(s.trs)))];
    langs.sort((a, b) => (a === "eng" ? -1 : b === "eng" ? 1 : a.localeCompare(b)));
    const langSel = document.getElementById("t-lang") as HTMLSelectElement | null;
    if (!langSel) throw new Error("missing #t-lang");
    langSel.replaceChildren(
      ...langs.map((l) => {
        const o = document.createElement("option");
        o.value = l;
        o.textContent = langNames[l] ?? l;
        return o;
      })
    );
    langSel.addEventListener("change", () => {
      state.lang = langSel.value;
      state.expanded = false;
      render();
    });

    const state = { lang: "eng", expanded: false };
    const PREVIEW = 50;
    const F = () => dhFilter() ?? { years: new Set<number>(), topics: new Set<number>(), q: "" };

    const rowsMaybe = document.getElementById("t-rows");
    const countMaybe = document.getElementById("t-count");
    const moreMaybe = document.getElementById("t-more");
    if (!rowsMaybe || !countMaybe || !moreMaybe) throw new Error("missing transcript elements");
    const rowsEl: HTMLElement = rowsMaybe;
    const countEl: HTMLElement = countMaybe;
    const moreEl: HTMLElement = moreMaybe;

    moreEl.addEventListener("click", () => {
      state.expanded = true;
      render();
    });

    function render() {
      const f = F();
      const q = f.q.toLowerCase();
      const list = all.filter(
        (s: ObservatorySession) =>
          s.trs[state.lang] &&
          (f.years.size === 0 || f.years.has(s.y)) &&
          (f.topics.size === 0 || s.k.some((id: number) => f.topics.has(id))) &&
          (!q || s.t.toLowerCase().includes(q) || s.id.includes(q))
      );
      countEl.textContent = `${list.length.toLocaleString("en")} transcripts · ${langNames[state.lang] ?? state.lang}`;

      const visible = state.expanded ? list : list.slice(0, PREVIEW);
      rowsEl.replaceChildren(
        ...visible.map((s: ObservatorySession) => {
          const tr = document.createElement("tr");
          const topic = topicMeta.get(s.p ?? s.k[0]);
          tr.innerHTML = `
            <td class="num mono-id">${s.id.split("-")[1] ?? s.id}</td>
            <td><a href="/sessions/${s.id}/"></a></td>
            <td>${topic?.glyph ? `<img class="topic-glyph" src="${topic.glyph}" alt="${topic.title}" title="${topic.title}" width="18" height="18" loading="lazy">` : ""}</td>
            <td class="mono-id">’${String(s.y).slice(2)}</td>
            <td class="num">${Math.round(s.d / 60)}</td>
            <td class="dl"></td>
            <td class="dl"></td>`;
          const link = tr.querySelector("a");
          if (link) link.textContent = s.t;
          const cells = tr.querySelectorAll(".dl");
          ([["srt", "Download subtitles"], ["txt", "Download plain text"]] as const).forEach(([kind, title], i) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "chip";
            b.textContent = `↓ .${kind}`;
            b.title = title;
            b.addEventListener("click", (e) =>
              downloadTranscript(s.id, s.trs[state.lang], kind, e.currentTarget)
            );
            cells[i].append(b);
          });
          return tr;
        })
      );
      moreEl.hidden = state.expanded || list.length <= PREVIEW;
      moreEl.textContent = `Show all ${list.length.toLocaleString("en")}`;
    }

    render();
    addEventListener("dh-filter", () => {
      state.expanded = false;
      render();
    });
  </script>
</Base>

