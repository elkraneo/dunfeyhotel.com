---
import Base from "../layouts/Base.astro";
import { sessions } from "../lib/data.js";

const total = sessions.filter((s) => s.hasTranscript).length;
---

<Base
  title="Transcripts"
  description={`Full transcripts for ${total.toLocaleString("en")} WWDC sessions — filter, then take them as .srt or plain text.`}
  wide
  searchable={false}
>
  <section class="hero">
    <p class="kicker">The stenographer</p>
    <h1>Transcripts.</h1>
    <p class="lede">
      {total.toLocaleString("en")} sessions with full text. Filter, then take
      each as <code>.srt</code> or plain text — converted in your browser,
      straight from Apple's source.
    </p>
  </section>

  <p class="meta" id="t-count" role="status"></p>
  <table class="ledger" data-dh-reactive>
    <caption class="visually-hidden">Sessions with transcripts</caption>
    <thead>
      <tr>
        <th scope="col">№</th>
        <th scope="col">Session</th>
        <th scope="col">Topic</th>
        <th scope="col">Edition</th>
        <th scope="col" class="num">Min</th>
        <th scope="col" colspan="2">Download</th>
      </tr>
    </thead>
    <tbody id="t-rows"></tbody>
  </table>
  <p><button type="button" class="watch secondary" id="t-more" hidden>Show everything</button></p>

  <script>
    import index from "../../data/normalized/observatory-index.json";
    import explorer from "../../data/normalized/explorer.json";

    const topicMeta = new Map(explorer.topics.map((t) => [t.id, t]));
    const all = index.sessions
      .filter((s) => s.tr && s.trUrl)
      .sort((a, b) => b.y - a.y || a.t.localeCompare(b.t));
    const years = [...new Set(all.map((s) => s.y))].sort();

    const state = { expanded: false };
    const PREVIEW = 50;
    const F = () => window.dhFilter ?? { years: new Set(), topics: new Set(), q: "" };

    const rowsEl = document.getElementById("t-rows");
    const countEl = document.getElementById("t-count");
    const moreEl = document.getElementById("t-more");

    moreEl.addEventListener("click", () => {
      state.expanded = true;
      render();
    });

    // ——— transcript conversion (parity with the app, improved cue ends:
    // each cue ends where the next begins; the last gets +4s) ———
    const pad = (n, w = 2) => String(n).padStart(w, "0");
    const stamp = (sec) =>
      `${pad(Math.floor(sec / 3600))}:${pad(Math.floor((sec % 3600) / 60))}:${pad(Math.floor(sec % 60))},${pad(Math.round((sec % 1) * 1000), 3)}`;

    const entriesOf = (json) => Object.values(json)[0]?.transcript ?? [];

    const toSRT = (json) => {
      const entries = entriesOf(json);
      return entries
        .map(([time, text], i) => {
          const end = i + 1 < entries.length ? entries[i + 1][0] : time + 4;
          return `${i + 1}\n${stamp(time)} --> ${stamp(end)}\n${String(text).trim()}\n`;
        })
        .join("\n");
    };

    const toTXT = (json) =>
      entriesOf(json)
        .map(([, text]) => String(text))
        .join("")
        .replace(/\n{3,}/g, "\n\n")
        .trim();

    async function download(s, kind, button) {
      button.disabled = true;
      try {
        const json = await fetch(s.trUrl).then((r) => r.json());
        const content = kind === "srt" ? toSRT(json) : toTXT(json);
        const blob = new Blob([content], { type: "text/plain;charset=utf-8" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `${s.id}.${kind === "srt" ? "srt" : "txt"}`;
        a.click();
        URL.revokeObjectURL(a.href);
      } catch {
        open(s.trUrl, "_blank");
      } finally {
        button.disabled = false;
      }
    }

    function render() {
      const f = F();
      const q = f.q.toLowerCase();
      const list = all.filter(
        (s) =>
          (f.years.size === 0 || f.years.has(s.y)) &&
          (f.topics.size === 0 || s.k.some((id) => f.topics.has(id))) &&
          (!q || s.t.toLowerCase().includes(q) || s.id.includes(q))
      );
      countEl.textContent = `${list.length.toLocaleString("en")} transcripts`;

      const visible = state.expanded ? list : list.slice(0, PREVIEW);
      rowsEl.replaceChildren(
        ...visible.map((s) => {
          const tr = document.createElement("tr");
          const topic = topicMeta.get(s.p ?? s.k[0]);
          tr.innerHTML = `
            <td class="num mono-id">${s.id.split("-")[1] ?? s.id}</td>
            <td><a href="/sessions/${s.id}/"></a></td>
            <td>${topic?.glyph ? `<img class="topic-glyph" src="${topic.glyph}" alt="${topic.title}" title="${topic.title}" width="18" height="18" loading="lazy">` : ""}</td>
            <td class="mono-id">’${String(s.y).slice(2)}</td>
            <td class="num">${Math.round(s.d / 60)}</td>
            <td class="dl"></td>
            <td class="dl"></td>`;
          tr.querySelector("a").textContent = s.t;
          const cells = tr.querySelectorAll(".dl");
          [["srt", "Download subtitles"], ["txt", "Download plain text"]].forEach(([kind, title], i) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "chip";
            b.textContent = `↓ .${kind}`;
            b.title = title;
            b.addEventListener("click", (e) => download(s, kind, e.currentTarget));
            cells[i].append(b);
          });
          return tr;
        })
      );
      moreEl.hidden = state.expanded || list.length <= PREVIEW;
      moreEl.textContent = `Show all ${list.length.toLocaleString("en")}`;
    }

    render();
    addEventListener("dh-filter", () => {
      state.expanded = false;
      render();
    });
  </script>
</Base>

<style is:global>
  .filter-input {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 0.4rem 0.7rem;
    min-inline-size: 16rem;
  }

  .mono-id {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  td.dl .chip {
    font-size: 0.66rem;
    padding: 0.18rem 0.5rem;
  }

  table[data-dh-reactive] td a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 560;
  }

  table[data-dh-reactive] td a:hover {
    color: var(--oxblood);
  }
</style>
