---
import Base from "../layouts/Base.astro";
import { resources } from "../lib/data.js";

const total = resources.length;
---

<Base
  title="Resources"
  description={`${total.toLocaleString("en")} documents, sample projects, guides and downloads referenced across WWDC — filterable by type, each linked to its citing sessions.`}
  wide
  searchable={false}
>
  <section class="hero">
    <p class="kicker">The vault</p>
    <h1>Resources.</h1>
    <p class="lede">
      Every document, sample project, guide and download the sessions
      reference — with the sessions that cite each one. Items Apple removed
      from its catalog are preserved from our archive, marked
      <span class="delisted">[delisted]</span>.
    </p>
  </section>

  <div class="controls" role="group" aria-label="Resource filters">
    <div class="lens">
      <p class="kicker" id="r-types-label">Type</p>
      <div class="chip-row" role="group" aria-labelledby="r-types-label" id="r-type-chips"></div>
    </div>
  </div>

  <p class="meta" id="r-count" role="status"></p>
  <ul class="plain" id="r-rows" data-dh-reactive></ul>
  <p><button type="button" class="watch secondary" id="r-more" hidden>Show everything</button></p>

  <script>
    import allResources from "../../data/normalized/resources.json";
    import index from "../../data/normalized/observatory-index.json";

    const TYPE_LABELS = {
      samplecode: "Sample code",
      documentation: "Documentation",
      guide: "Guide",
      developerForum: "Forum",
      download: "Download",
    };
    const sessionMeta = new Map(index.sessions.map((s) => [s.id, s]));

    const all = allResources
      .filter((r) => r.type && r.title && r.url)
      .sort((a, b) => a.title.localeCompare(b.title));
    const types = [...new Set(all.map((r) => r.type))].sort();

    const state = { type: null, expanded: false };
    const PREVIEW = 60;
    const F = () => window.dhFilter ?? { years: new Set(), topics: new Set(), q: "" };

    const rowsEl = document.getElementById("r-rows");
    const countEl = document.getElementById("r-count");
    const moreEl = document.getElementById("r-more");
    const typeChips = document.getElementById("r-type-chips");

    for (const t of [null, ...types]) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip";
      b.textContent = t === null ? "All" : (TYPE_LABELS[t] ?? t);
      b.addEventListener("click", () => {
        state.type = t;
        state.expanded = false;
        render();
      });
      b.dataset.type = t ?? "";
      typeChips.append(b);
    }

    moreEl.addEventListener("click", () => {
      state.expanded = true;
      render();
    });

    const copy = (text, button) => {
      navigator.clipboard?.writeText(text);
      const old = button.textContent;
      button.textContent = "copied";
      setTimeout(() => (button.textContent = old), 900);
    };

    // A resource matches years/topics through the sessions that cite it.
    function matchesFilter(r, f) {
      if (!f.years.size && !f.topics.size) return true;
      return r.sessionIds.some((id) => {
        const s = sessionMeta.get(id);
        if (!s) return false;
        return (
          (f.years.size === 0 || f.years.has(s.y)) &&
          (f.topics.size === 0 || s.k.some((tid) => f.topics.has(tid)))
        );
      });
    }

    function render() {
      typeChips.querySelectorAll(".chip").forEach((b) =>
        b.setAttribute("aria-pressed", String((b.dataset.type || null) === state.type))
      );

      const f = F();
      const q = f.q.toLowerCase();
      const list = all.filter(
        (r) =>
          (state.type === null || r.type === state.type) &&
          matchesFilter(r, f) &&
          (!q ||
            r.title.toLowerCase().includes(q) ||
            (r.description ?? "").toLowerCase().includes(q))
      );
      countEl.textContent = `${list.length.toLocaleString("en")} resources`;

      const visible = state.expanded ? list : list.slice(0, PREVIEW);
      rowsEl.replaceChildren(
        ...visible.map((r) => {
          const li = document.createElement("li");
          const head = document.createElement("span");
          head.innerHTML = `<span class="meta">[${TYPE_LABELS[r.type] ?? r.type}]</span> ${r.delisted ? `<span class="meta delisted" title="No longer listed by Apple; preserved from our archive">[delisted ${r.lastSeen}]</span> ` : ""}`;
          const link = document.createElement("a");
          link.href = r.url;
          link.rel = "external";
          link.innerHTML = "<strong></strong>";
          link.querySelector("strong").textContent = r.title;
          li.append(head, link);
          if (r.description) li.append(` — ${r.description}`);

          const meta = document.createElement("span");
          meta.className = "meta";
          if (r.sessionIds.length) {
            meta.append(" · in ");
            r.sessionIds.slice(0, 4).forEach((id, i) => {
              if (i) meta.append(", ");
              const a = document.createElement("a");
              a.href = `/sessions/${id}/`;
              a.title = sessionMeta.get(id)?.t ?? id;
              a.textContent = `§${id.replace("wwdc", "'").replace("-", " ")}`;
              meta.append(a);
            });
            if (r.sessionIds.length > 4) meta.append(` +${r.sessionIds.length - 4}`);
          }
          const copyBtn = document.createElement("button");
          copyBtn.type = "button";
          copyBtn.className = "linkish";
          copyBtn.textContent = "copy url";
          copyBtn.addEventListener("click", (e) => copy(r.url, e.currentTarget));
          meta.append(" · ", copyBtn);
          li.append(meta);
          return li;
        })
      );
      moreEl.hidden = state.expanded || list.length <= PREVIEW;
      moreEl.textContent = `Show all ${list.length.toLocaleString("en")}`;
    }

    render();
    addEventListener("dh-filter", () => {
      state.expanded = false;
      render();
    });
  </script>
</Base>
