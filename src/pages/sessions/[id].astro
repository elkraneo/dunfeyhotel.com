---
import SessionCard from "../../components/SessionCard.astro";
import Base from "../../layouts/Base.astro";
import {
  sessions,
  sessionById,
  resourceById,
  formatDuration,
  formatTimestamp,
  timeLink,
  topicSlug,
} from "../../lib/data.js";

export function getStaticPaths() {
  return sessions.map((s) => ({ params: { id: s.id }, props: { session: s } }));
}

const { session: s } = Astro.props;
const related = s.related.map((id) => sessionById.get(id)).filter(Boolean);
const res = s.resourceIds.map((id) => resourceById.get(id)).filter(Boolean);
---

<Base title={s.title} description={s.description ?? undefined} ogImage={s.ogImage}>
  <article>
    <header class="session-head">
      {s.thumb && (
        <img
          class="session-art"
          src={s.ogImage ?? s.thumb}
          alt=""
          width="450"
          height="253"
          loading="eager"
          onerror="this.remove()"
        />
      )}
      <p class="kicker">
        <a href={`/years/${s.year}/`}>WWDC{String(s.year).slice(2)}</a> ·
        {formatDuration(s.duration)} ·
        {s.topics.map((t, i) => (
          <>
            {i > 0 && " / "}
            <a href={`/topics/${topicSlug(t)}/`}>{t}</a>
          </>
        ))}
      </p>
      <h1>{s.title}</h1>
      {s.description && <p class="lede">{s.description}</p>}
      <a class="watch" href={s.webPermalink} rel="external">
        Watch at developer.apple.com ↗
      </a>
      {s.hasTranscript && (
        <p class="meta">
          Transcript available on the session page at Apple (full text searchable
          there).
        </p>
      )}
    </header>

    {s.chapters.length > 0 && (
      <section class="block" aria-labelledby={`chapters-${s.id}`}>
        <h2 class="kicker" id={`chapters-${s.id}`}>Chapters</h2>
        <ul class="plain">
          {s.chapters.map((c) => (
            <li>
              <a class="timestamp-link" href={timeLink(s, c.start)} rel="external">
                {formatTimestamp(c.start)}
              </a>
              {" — "}
              {c.title}
            </li>
          ))}
        </ul>
      </section>
    )}

    {s.codeSnippets.length > 0 && (
      <section class="block" aria-labelledby={`code-${s.id}`}>
        <h2 class="kicker" id={`code-${s.id}`}>
          Code shown on screen · {s.codeSnippets.length} {s.codeSnippets.length === 1 ? "snippet" : "snippets"}
        </h2>
        {s.codeSnippets.map((snip) => (
          <details class="snippet">
            <summary>
              {snip.title}
              <span class="snippet-meta">
                {snip.language ?? "code"} ·
                <a href={timeLink(s, snip.startTimeSeconds)} rel="external">
                  at {formatTimestamp(snip.startTimeSeconds ?? 0)} ↗
                </a>
              </span>
            </summary>
            <pre><code>{snip.code}</code></pre>
          </details>
        ))}
      </section>
    )}

    {res.length > 0 && (
      <section class="block" aria-labelledby={`resources-${s.id}`}>
        <h2 class="kicker" id={`resources-${s.id}`}>Resources</h2>
        <ul class="plain">
          {res.map((r) => (
            <li>
              <span class="meta">[{r.type}]</span>{" "}
              <a href={r.url} rel="external">{r.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="block" aria-labelledby={`related-${s.id}`}>
        <h2 class="kicker" id={`related-${s.id}`}>Related sessions</h2>
        <ul class="session-rows">
          {related.map((r) => (
            <SessionCard session={r} />
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
