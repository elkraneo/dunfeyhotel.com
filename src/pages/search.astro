---
import Base from "../layouts/Base.astro";
---

<Base
  title="Search"
  description="Full-text search across every session, code snippet, document and dispatch."
  searchable={false}
>
  <section class="hero">
    <p class="kicker">The concierge</p>
    <h1>Search the registry.</h1>
    <p class="lede">
      Full-text search from the front desk above — titles, descriptions,
      on-screen code, catalogs and dispatches. Year and topic chips narrow the
      results.
    </p>
  </section>

  <div class="s-controls">
    <p class="meta" id="s-count" role="status"></p>
    <label class="s-lost-toggle">
      <input type="checkbox" id="s-lost-check" checked />
      Include lost &amp; found results
    </label>
  </div>
  <ol class="plain search-results" id="s-results" data-dh-reactive></ol>
  <p><button type="button" class="watch secondary" id="s-more" hidden>More results</button></p>

  <script is:inline type="module">
    const countEl = document.getElementById("s-count");
    const resultsEl = document.getElementById("s-results");
    const moreEl = document.getElementById("s-more");
    const lostCheck = document.getElementById("s-lost-check");
    const F = () => window.dhFilter ?? { years: new Set(), topics: new Set(), q: "" };
    const isLost = (url) => url.startsWith("/lost-and-found/");
    let includeLost = true;

    const esc = (s) =>
      s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    // A description of the active front-desk filters, e.g. "2 topics and 1 year".
    const filterBits = (f) => {
      const bits = [];
      if (f.topics.size) bits.push(`${f.topics.size} topic${f.topics.size > 1 ? "s" : ""}`);
      if (f.years.size) bits.push(`${f.years.size} year${f.years.size > 1 ? "s" : ""}`);
      return bits;
    };

    // Drop the year/topic chips (keep the query) and reload so the front desk
    // re-syncs cleanly — avoids duplicating its internal sync logic here.
    const clearFilters = () => {
      try {
        const stored = JSON.parse(sessionStorage.getItem("dh-filter") || "{}");
        stored.topics = [];
        stored.years = [];
        sessionStorage.setItem("dh-filter", JSON.stringify(stored));
      } catch {}
      const q = F().q;
      location.href = q ? `/search/?q=${encodeURIComponent(q)}` : "/search/";
    };

    let pagefind = null;
    try {
      pagefind = await import("/pagefind/pagefind.js");
      pagefind.init();
    } catch {
      countEl.textContent = "Search index not built yet — run npm run build.";
    }

    const PAGE = 12;
    let shown = PAGE;
    let lastResults = [];
    let renderGen = 0;

    moreEl.addEventListener("click", () => {
      shown += PAGE;
      renderList();
    });

    async function renderList() {
      // Walk results lazily, keeping up to `shown` that pass the filters.
      // A generation token lets a newer render cancel a slow in-flight one
      // (filtering to a rare type can walk the whole result set).
      const gen = ++renderGen;
      const items = [];
      let i = 0;
      while (i < lastResults.length && items.length < shown) {
        const d = await lastResults[i].data();
        if (gen !== renderGen) return;
        i++;
        if (!includeLost && isLost(d.url)) continue;
        items.push(d);
      }
      resultsEl.replaceChildren(
        ...items.map((d) => {
          const li = document.createElement("li");
          const lost = isLost(d.url);
          if (lost) li.className = "lost";
          const h = document.createElement("h3");
          const a = document.createElement("a");
          a.href = d.url;
          // Strip the "— lost & found" suffix; a badge carries the marker.
          a.textContent = lost
            ? (d.meta?.title ?? d.url).replace(/\s*—\s*lost & found$/i, "")
            : d.meta?.title ?? d.url;
          h.append(a);
          if (lost) {
            const badge = document.createElement("span");
            badge.className = `lf-badge${d.meta?.status === "removed" ? " removed" : ""}`;
            badge.textContent = d.meta?.status === "removed" ? "removed" : "lost & found";
            h.append(" ", badge);
          }
          const ex = document.createElement("p");
          ex.className = "excerpt";
          ex.innerHTML = d.excerpt ?? "";
          li.append(h, ex);
          for (const sub of (d.sub_results ?? []).slice(0, 2)) {
            if (sub.url === d.url) continue;
            const sp = document.createElement("p");
            sp.className = "excerpt sub";
            const sa = document.createElement("a");
            sa.href = sub.url;
            sa.textContent = `↳ ${sub.title}`;
            sp.append(sa, document.createElement("br"));
            const se = document.createElement("span");
            se.innerHTML = sub.excerpt ?? "";
            sp.append(se);
            li.append(sp);
          }
          return li;
        })
      );
      // More remains while results past the filtered window are left.
      moreEl.hidden = i >= lastResults.length;
    }

    let timer;
    async function run() {
      if (!pagefind) return;
      const f = F();
      const filters = {};
      if (f.years.size) filters.year = [...f.years].map(String);
      if (f.topics.size)
        filters.topic = [...f.topics]
          .map((id) => window.dhTopicTitles?.[id])
          .filter(Boolean);
      const q = f.q || null;
      if (!q && !Object.keys(filters).length) {
        countEl.textContent = "Type to search, or filter by year and topic.";
        resultsEl.replaceChildren();
        moreEl.hidden = true;
        return;
      }
      const res = await pagefind.search(q, Object.keys(filters).length ? { filters } : {});
      lastResults = res.results;
      shown = PAGE;
      const bits = filterBits(f);
      const n = res.results.length;
      if (n === 0 && bits.length) {
        // Make clear the zero is a filter narrowing the catalog, not an absence.
        countEl.innerHTML =
          `No results${q ? ` for “${esc(q)}”` : ""} — narrowed by ${bits.join(" and ")}. ` +
          `<button type="button" class="linkish" id="s-clear-filters">Clear filters</button> to broaden.`;
        document.getElementById("s-clear-filters")?.addEventListener("click", clearFilters);
      } else {
        countEl.textContent =
          `${n.toLocaleString("en")} result${n === 1 ? "" : "s"}` +
          (bits.length ? ` · narrowed by ${bits.join(" and ")}` : "");
      }
      renderList();
    }

    lostCheck.addEventListener("change", () => {
      includeLost = lostCheck.checked;
      shown = PAGE;
      renderList();
    });

    addEventListener("dh-filter", () => {
      clearTimeout(timer);
      timer = setTimeout(run, 120);
    });
    run();
    // The search box lives in the front desk — make sure it's open and ready
    // on this page, whatever the global collapsed state.
    document.querySelector(".registry-bar")?.setAttribute("open", "");
    document.getElementById("dh-q")?.focus();
  </script>
</Base>

<style is:global>
  .search-results {
    max-width: var(--measure);
  }

  .search-results li {
    padding-block: 0.9rem;
    border-bottom: 1px dotted var(--rule-strong);
  }

  .search-results h3 {
    font-size: 1.08rem;
    margin: 0 0 0.25rem;
  }

  .search-results .excerpt {
    margin: 0.15rem 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .search-results .excerpt.sub {
    margin-inline-start: 1.1rem;
  }

  .search-results mark {
    background: transparent;
    color: var(--ink);
    font-weight: 650;
    border-bottom: 2px solid var(--brass);
  }

  .s-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.2rem;
    margin-block: 0.4rem 0.8rem;
  }

  .s-lost-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-soft);
    cursor: pointer;
    user-select: none;
  }

  .s-lost-toggle input {
    inline-size: 0.95rem;
    block-size: 0.95rem;
    cursor: pointer;
  }

  /* Recovered records read as secondary to live content — present, but the
     archive layer, not the front of the catalog. */
  .search-results li.lost h3 a {
    color: var(--ink-soft);
  }

  .lf-badge {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    vertical-align: middle;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .lf-badge.removed {
    color: var(--oxblood);
    border-color: var(--oxblood);
  }
</style>
