---
import Base from "../layouts/Base.astro";
---

<Base
  title="Search"
  description="Full-text search across every session, code snippet, document and dispatch."
  searchable={false}
>
  <section class="hero">
    <p class="kicker">The concierge</p>
    <h1>Ask for anything in the registry.</h1>
    <p class="lede">
      Type in the cross-section bar above — full text of titles, descriptions,
      on-screen code, catalogs and dispatches.
    </p>
  </section>

  <div id="search" data-dh-reactive></div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof PagefindUI !== "undefined") {
        const ui = new PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: false,
          pageSize: 10,
        });
        // The cross-section bar is the only input: it drives Pagefind live.
        const run = () => ui.triggerSearch(window.dhFilter?.q ?? "");
        run();
        addEventListener("dh-filter", run);
        const barInput = document.getElementById("dh-q");
        if (barInput) barInput.focus();
      } else {
        document.getElementById("search").innerHTML =
          "<p>Search index not built yet — run <code>npm run build</code> (Pagefind indexes the built site).</p>";
      }
    });
  </script>
</Base>

<style is:global>
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--oxblood);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--rule-strong);
    --pagefind-ui-tag: var(--paper-deep);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-font: var(--font-display);
    max-width: var(--measure);
  }

  #search .pagefind-ui__search-input {
    font-family: var(--font-display);
    background: var(--paper);
  }

  #search .pagefind-ui__result-title {
    font-weight: 560;
  }

  #search mark {
    background: transparent;
    color: inherit;
    font-weight: 650;
    border-bottom: 2px solid var(--brass);
  }

  #search .pagefind-ui__search-clear {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oxblood);
  }

  /* The bar is the input; Pagefind's own form stays hidden. */
  #search .pagefind-ui__form > .pagefind-ui__search-input,
  #search .pagefind-ui__search-clear {
    display: none;
  }
</style>
