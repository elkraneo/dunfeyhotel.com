---
import Base from "../layouts/Base.astro";
---

<Base
  title="Search"
  description="Full-text search across every session, code snippet, document and dispatch."
  searchable={false}
>
  <section class="hero">
    <p class="kicker">The concierge</p>
    <h1>Ask for anything in the registry.</h1>
    <p class="lede">
      Type in the cross-section bar above — full text of titles, descriptions,
      on-screen code, catalogs and dispatches. Year and topic chips narrow the
      results.
    </p>
  </section>

  <p class="meta" id="s-count" role="status"></p>
  <ol class="plain search-results" id="s-results" data-dh-reactive></ol>
  <p><button type="button" class="watch secondary" id="s-more" hidden>More results</button></p>

  <script is:inline type="module">
    const countEl = document.getElementById("s-count");
    const resultsEl = document.getElementById("s-results");
    const moreEl = document.getElementById("s-more");
    const F = () => window.dhFilter ?? { years: new Set(), topics: new Set(), q: "" };

    let pagefind = null;
    try {
      pagefind = await import("/pagefind/pagefind.js");
      pagefind.init();
    } catch {
      countEl.textContent = "Search index not built yet — run npm run build.";
    }

    const PAGE = 12;
    let shown = PAGE;
    let lastResults = [];

    moreEl.addEventListener("click", () => {
      shown += PAGE;
      renderList();
    });

    async function renderList() {
      const slice = lastResults.slice(0, shown);
      const items = await Promise.all(slice.map((r) => r.data()));
      resultsEl.replaceChildren(
        ...items.map((d) => {
          const li = document.createElement("li");
          const h = document.createElement("h3");
          const a = document.createElement("a");
          a.href = d.url;
          a.textContent = d.meta?.title ?? d.url;
          h.append(a);
          const ex = document.createElement("p");
          ex.className = "excerpt";
          ex.innerHTML = d.excerpt ?? "";
          li.append(h, ex);
          for (const sub of (d.sub_results ?? []).slice(0, 2)) {
            if (sub.url === d.url) continue;
            const sp = document.createElement("p");
            sp.className = "excerpt sub";
            const sa = document.createElement("a");
            sa.href = sub.url;
            sa.textContent = `↳ ${sub.title}`;
            sp.append(sa, document.createElement("br"));
            const se = document.createElement("span");
            se.innerHTML = sub.excerpt ?? "";
            sp.append(se);
            li.append(sp);
          }
          return li;
        })
      );
      moreEl.hidden = shown >= lastResults.length;
    }

    let timer;
    async function run() {
      if (!pagefind) return;
      const f = F();
      const filters = {};
      if (f.years.size) filters.year = [...f.years].map(String);
      if (f.topics.size)
        filters.topic = [...f.topics]
          .map((id) => window.dhTopicTitles?.[id])
          .filter(Boolean);
      const q = f.q || null;
      if (!q && !Object.keys(filters).length) {
        countEl.textContent = "Type, or press a chip — the registry answers.";
        resultsEl.replaceChildren();
        moreEl.hidden = true;
        return;
      }
      const res = await pagefind.search(q, Object.keys(filters).length ? { filters } : {});
      lastResults = res.results;
      shown = PAGE;
      countEl.textContent = `${res.results.length.toLocaleString("en")} results`;
      renderList();
    }

    addEventListener("dh-filter", () => {
      clearTimeout(timer);
      timer = setTimeout(run, 120);
    });
    run();
    document.getElementById("dh-q")?.focus();
  </script>
</Base>

<style is:global>
  .search-results {
    max-width: var(--measure);
  }

  .search-results li {
    padding-block: 0.9rem;
    border-bottom: 1px dotted var(--rule-strong);
  }

  .search-results h3 {
    font-size: 1.08rem;
    margin: 0 0 0.25rem;
  }

  .search-results .excerpt {
    margin: 0.15rem 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .search-results .excerpt.sub {
    margin-inline-start: 1.1rem;
  }

  .search-results mark {
    background: transparent;
    color: var(--ink);
    font-weight: 650;
    border-bottom: 2px solid var(--brass);
  }
</style>
