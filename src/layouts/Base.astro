---
import "../styles/global.css";
import RegistryBar from "../components/RegistryBar.astro";
import { aggregates, sessions, years } from "../lib/data.js";

const { title, description, ogImage, wide = false, searchable = true } = Astro.props;

const path = Astro.url.pathname;
// Years and topics are indexed on the homepage registry; text search lives in
// the cross-section bar. The nav carries the lenses.
const nav = [
  { label: "Observatory", href: "/observatory/", section: "/observatory" },
  { label: "Transcripts", href: "/transcripts/", section: "/transcripts" },
  { label: "Resources", href: "/resources/", section: "/resources" },
  { label: "Dispatches", href: "/dispatches/", section: "/dispatches" },
  { label: "About", href: "/about/", section: "/about" },
];
const current = (section) => (path.startsWith(section) ? "page" : undefined);
const fullTitle = title ? `${title} · Dunfey Hotel` : "Dunfey Hotel — WWDC as data";
const desc =
  description ??
  "Every WWDC session since 2014 — categories, durations, code snippets, transcripts and trends. Links to Apple, hosts nothing.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const legacy = localStorage.getItem("dh-theme");
          if (legacy && !localStorage.getItem("dh-theme-family")) {
            const map = {
              ledger: ["ledger", "light"],
              night: ["ledger", "dark"],
              cupertino: ["cupertino", "light"],
              auto: ["ledger", "auto"],
            };
            const [f, m] = map[legacy] ?? ["ledger", "auto"];
            localStorage.setItem("dh-theme-family", f);
            localStorage.setItem("dh-theme-mode", m);
          }
          const family = localStorage.getItem("dh-theme-family") || "ledger";
          const mode = localStorage.getItem("dh-theme-mode") || "auto";
          const dark =
            mode === "dark" ||
            (mode === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.theme =
            family === "cupertino"
              ? dark ? "cupertino-night" : "cupertino"
              : dark ? "night" : "ledger";
        } catch {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..700,0..100,0..1&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={["shell", { wide }]}>
      <header class="masthead">
        <a class="wordmark" href="/">Dunfey<span class="amp"> · </span>Hotel</a>
        <span class="tagline">WWDC as data, est. 1983</span>
        <nav aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={current(item.section)}>{item.label}</a>
          ))}
          <select id="theme-family" class="theme-select" aria-label="Theme">
            <option value="ledger">Ledger</option>
            <option value="cupertino">Cupertino</option>
          </select>
          <select id="theme-mode" class="theme-select" aria-label="Appearance">
            <option value="auto">Auto</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </nav>
      </header>
      <RegistryBar open={wide} />
      <main id="main" data-pagefind-body={searchable ? "" : undefined}>
        <slot />
      </main>
      <footer class="colophon">
        <div>
          <p class="meta">
            {sessions.length.toLocaleString("en")} sessions · {years[0]}–{years.at(-1)} ·
            all content © Apple Inc. —
            <a href="https://developer.apple.com">linked, never rehosted</a>
          </p>
          <p class="meta">
            made with ★ in Berlin by <a href="https://elkraneo.com">elkraneo</a>
          </p>
        </div>
        <p class="stamp">
          Dunfey Hotel Registry<br />
          Snapshot № {aggregates.snapshotId}<br />
          {aggregates.snapshotUpdated.slice(0, 10)}
        </p>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const familySel = document.getElementById("theme-family");
        const modeSel = document.getElementById("theme-mode");
        if (!familySel || !modeSel) return;
        const media = matchMedia("(prefers-color-scheme: dark)");
        const get = (k, d) => {
          try {
            return localStorage.getItem(k) || d;
          } catch {
            return d;
          }
        };
        const apply = () => {
          const family = get("dh-theme-family", "ledger");
          const mode = get("dh-theme-mode", "auto");
          const dark = mode === "dark" || (mode === "auto" && media.matches);
          document.documentElement.dataset.theme =
            family === "cupertino"
              ? dark ? "cupertino-night" : "cupertino"
              : dark ? "night" : "ledger";
          dispatchEvent(new CustomEvent("dh-theme"));
        };
        familySel.value = get("dh-theme-family", "ledger");
        modeSel.value = get("dh-theme-mode", "auto");
        familySel.addEventListener("change", () => {
          try {
            localStorage.setItem("dh-theme-family", familySel.value);
          } catch {}
          apply();
        });
        modeSel.addEventListener("change", () => {
          try {
            localStorage.setItem("dh-theme-mode", modeSel.value);
          } catch {}
          apply();
        });
        media.addEventListener("change", apply);
      })();
    </script>
  </body>
</html>
